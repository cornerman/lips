{
  "name": "lips",
  "displayName": "lips",
  "description": "Completion and diagnostics for lips programs via the lips language server.",
  "version": "0.0.1",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:lips"],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      { "id": "lips", "aliases": ["lips"], "extensions": [".lips"] }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  }
}
