artifact.<self>.fill.repaintTarget \"\\\"<value.2>\\\"\"\n0.9 r5 match fact button.erase => artifact.<self>.fill.eraseLabel \"\\\"<value.1>\\\"\" ; artifact.<self>.fill.eraseTarget \"\\\"<value.2>\\\"\"\n0.9 r6 match fact button.download => artifact.<self>.fill.downloadLabel \"\\\"<value.1>\\\"\" ; artifact.<self>.fill.downloadTarget \"\\\"<value.2>\\\"\"\n0.95 q1 demand site.port \"on which TCP port should the website be served?\"\n0.9 q2 demand canvas.name \"what is the canvas called (its id)?\"\n0.9 q3 demand canvas.content \"what does the canvas show?\"\n0.9 q4 demand button.repaint \"which button label draws a new random painting, and in which canvas?\"\n0.9 q5 demand button.erase \"which button label erases a canvas, and which canvas?\"\n0.9 q6 demand button.download \"which button label downloads a picture, and from which canvas?\"\n0.95 a1 expect services.nginx.defaultHTTPListenPort from site.port\n0.9 a2 expect artifact.<self>.fill.canvasId from canvas.name\n0.9 a3 expect artifact.<self>.fill.canvasDesc from canvas.content\n0.9 a4 expect artifact.<self>.fill.repaintLabel from button.repaint is \"<value.1>\"\n0.9 a5 expect artifact.<self>.fill.repaintTarget from button.repaint is \"<value.2>\"\n0.9 a6 expect artifact.<self>.fill.eraseLabel from button.erase is \"<value.1>\"\n0.9 a7 expect artifact.<self>.fill.eraseTarget from button.erase is \"<value.2>\"\n0.9 a8 expect artifact.<self>.fill.downloadLabel from button.download is \"<value.1>\"\n0.9 a9 expect artifact.<self>.fill.downloadTarget from button.download is \"<value.2>\"\n0.9 s1 source website index.html <<<lips\n<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>@canvasId@</title>\n<style>\nbody { font-family: sans-serif; margin: 2rem; background: #f6f6f6; }\nsvg.painting { border: 1px solid #888; background: #fff; display: block; }\nfigcaption { color: #555; font-size: .9rem; margin-top: .4rem; }\nbutton { margin-right: .5rem; font-size: 1rem; padding: .4rem .9rem; }\n</style>\n</head>\n<body>\n<figure>\n<svg id=\"@canvasId@\" class=\"painting\" width=\"640\" height=\"400\" viewBox=\"0 0 640 400\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"@canvasDesc@\"></svg>\n<figcaption>@canvasDesc@</figcaption>\n</figure>\n<p>\n<button id=\"btn-repaint\">@repaintLabel@</button>\n<button id=\"btn-erase\">@eraseLabel@</button>\n<button id=\"btn-download\">@downloadLabel@</button>\n</p>\n<script>\nvar SVGNS = \"http://www.w3.org/2000/svg\";\n\nfunction rnd(n) { return Math.floor(Math.random() * n); }\n\nfunction colour(alpha) {\n  return \"hsla(\" + rnd(360) + \", \" + (45 + rnd(50)) + \"%, \" + (40 + rnd(35)) + \"%, \" + alpha + \")\";\n}\n\nfunction shape(w, h) {\n  var kinds = [\"circle\", \"ellipse\", \"rect\", \"polygon\", \"line\"];\n  var kind = kinds[rnd(kinds.length)];\n  var el = document.createElementNS(SVGNS, kind);\n  if (kind === \"circle\") {\n    el.setAttribute(\"cx\", rnd(w));\n    el.setAttribute(\"cy\", rnd(h));\n    el.setAttribute(\"r\", 10 + rnd(Math.floor(h / 3)));\n  } else if (kind === \"ellipse\") {\n    el.setAttribute(\"cx\", rnd(w));\n    el.setAttribute(\"cy\", rnd(h));\n    el.setAttribute(\"rx\", 10 + rnd(Math.floor(w / 4)));\n    el.setAttribute(\"ry\", 10 + rnd(Math.floor(h / 4)));\n  } else if (kind === \"rect\") {\n    el.setAttribute(\"x\", rnd(w));\n    el.setAttribute(\"y\", rnd(h));\n    el.setAttribute(\"width\", 20 + rnd(Math.floor(w / 3)));\n    el.setAttribute(\"height\", 20 + rnd(Math.floor(h / 3)));\n  } else if (kind === \"polygon\") {\n    var pts = [];\n    var corners = 3 + rnd(4);\n    for (var i = 0; i < corners; i++) { pts.push(rnd(w) + \",\" + rnd(h)); }\n    el.setAttribute(\"points\", pts.join(\" \"));\n  } else {\n    el.setAttribute(\"x1\", rnd(w));\n    el.setAttribute(\"y1\", rnd(h));\n    el.setAttribute(\"x2\", rnd(w));\n    el.setAttribute(\"y2\", rnd(h));\n    el.setAttribute(\"stroke\", colour(0.9));\n    el.setAttribute(\"stroke-width\", 1 + rnd(8));\n    return el;\n  }\n  el.setAttribute(\"fill\", colour(0.55));\n  el.setAttribute(\"stroke\", colour(0.9));\n  el.setAttribute(\"stroke-width\", rnd(4));\n  return el;\n}\n\nfunction clear(id) {\n  var svg = document.getElementById(id);\n  while (svg.firstChild) { svg.removeChild(svg.firstChild); }\n}\n\nfunction paint(id) {\n  var svg = document.getElementById(id);\n  clear(id);\n  var w = svg.viewBox.baseVal.width || 640;\n  var h = svg.viewBox.baseVal.height || 400;\n  var back = document.createElementNS(SVGNS, \"rect\");\n  back.setAttribute(\"x\", 0);\n  back.setAttribute(\"y\", 0);\n  back.setAttribute(\"width\", w);\n  back.setAttribute(\"height\", h);\n  back.setAttribute(\"fill\", colour(0.25));\n  svg.appendChild(back);\n  var n = 6 + rnd(14);\n  for (var i = 0; i < n; i++) { svg.appendChild(shape(w, h)); }\n}\n\nfunction download(id) {\n  var svg = document.getElementById(id);\n  var text = new XMLSerializer().serializeToString(svg);\n  var blob = new Blob([text], { type: \"image/svg+xml;charset=utf-8\" });\n  var url = URL.createObjectURL(blob);\n  var a = document.createElement(\"a\");\n  a.href = url;\n  a.download = id + \".svg\";\n  document.body.appendChild(a);\n  a.click();\n  document.body.removeChild(a);\n  URL.revokeObjectURL(url);\n}\n\ndocument.getElementById(\"btn-repaint\").addEventListener(\"click\", function () { paint(\"@repaintTarget@\"); });\ndocument.getElementById(\"btn-erase\").addEventListener(\"click\", function () { clear(\"@eraseTarget@\"); });\ndocument.getElementById(\"btn-download\").addEventListener(\"click\", function () { download(\"@downloadTarget@\"); });\n\npaint(\"@canvasId@\");\n</script>\n</body>\n</html>\nlips>>>\n0.85 g1 gap repeating-source-block <<<lips\nblocked line: button \"drück mich\":\nA page has one HTML file, and each button is one <button> element plus one\nclick handler inside it. A fill replaces a marker; it cannot repeat a block\nof source per program item. So this language can carry exactly one button per\nACTION KIND (new painting, erase, download), each keyed by its action rather\nthan by its label -- a second \"new painting\" button, or a fourth kind of\nbutton, cannot be realized. Repro: add a second\n  button \"noch mal\":\n    on click: new random painting in canvas \"main\"\nblock -- both lines emit fact button.repaint and refinement refuses the\nprogram as a conflict.\nlips>>>\n0.85 g2 gap browser-observable <<<lips\nblocked line: content: shows a nice random svg painting\nThe behaviour the program states happens in a browser: shapes appear in an\nSVG element, a click clears it, a click downloads it. No claim command and no\ncontract can observe a DOM event, and the program states no example output to\ncompare against either, so the only observables minted here are \"nginx is\nactive\" and \"the page is served with status 200\". The painting code itself is\nheld by nothing.\nlips>>>\n0.95 d1 report <<<lips\n## What this language says\n\nA program describes one small interactive web page and the machine that\nserves it. Four line shapes are accepted:\n\n- `website running on port <port>` -- the TCP port the page is served on.\n- `canvas \"<name>\":` -- names the drawing surface; the name becomes the SVG\n  element's `id`.\n- `content: <words...>` -- written under a canvas line, describes what the\n  canvas shows; the words become the canvas's `aria-label` and its visible\n  caption.\n- `button \"<label>\":` followed by an indented `on click: ...` line. Three\n  click actions are understood, and each selects a mechanism rather than\n  carrying a value:\n  - `on click: new random painting in canvas \"<canvas>\"`\n  - `on click: erase everything in canvas \"<canvas>\"`\n  - `on click: download the picture from canvas \"<canvas>\"`\n  The label and the target canvas are values, so editing them changes the\n  page.\n\n## The mechanism\n\nThe page is one static `index.html`, baked from the source file beside this\nengine and built by `stdenvNoCC.mkDerivation` (it only copies the tree into\nthe store). Every word the program states reaches that file through a fill:\n`@canvasId@`, `@canvasDesc@`, and a label plus a target canvas for each of\nthe three buttons. The drawing itself -- random SVG shapes, clearing, and\nserialising the SVG into a download -- is generic JavaScript I wrote; the\nprogram's sentences choose only the ids, the labels and the wording.\n\nServing is `services.nginx`, per this project's standing preference over\nhand-rolled HTTP servers: the built store path becomes the virtual host's\n`root`, the host is the default one for the port, and the port also opens in\n`networking.firewall`. The port is set with `services.nginx.defaultHTTPListenPort`,\nso no listen record has to be written by hand.\n\nTwo observables run on a booted machine, because a configuration that\ncontains a web server is not yet a web server that runs: `systemctl is-active\nnginx.service` must say `active`, and a `curl` to `http://127.0.0.1:<port>/`\nmust answer `200`.\n\n## Limits you should know\n\n- Exactly one canvas per program, and at most one button per action kind,\n  because a fill cannot repeat a block of HTML per item (filed as a gap).\n- Every one of the six facts is demanded: a program missing the port, the\n  canvas, its content, or any of the three buttons is refused with a question,\n  rather than compiled into a page with an empty label.\n- Nothing checks the browser behaviour; see the second gap. What is pinned is\n  that each program word lands in the fill or option it belongs to, and that\n  the server really serves.\n\n## What I invented\n\nThe derivation version (`0.1.0`), the canvas geometry (640x400), the palette\nand the shape repertoire. None of these is stated by the program; only the\nport, the canvas name, its description, and the three labels with their target\ncanvases are.\nlips>>>\n"
