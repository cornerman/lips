-> submit_draft "0.95 p1 pattern website running on port <port> => fact site.port \"<port>\"\n0.9 p2.under.p1 pattern canvas \"<cname>\": => fact canvas.<n:index> \"<cname>\"\n0.9 p3.under.p2 pattern content: <desc.words> => fact <k:key>.content \"<desc>\"\n0.9 p4.under.p1 pattern button \"<label>\": => fact button.<n:index> \"<label>\"\n0.9 p5.under.p4 pattern on click: <act.words> => fact <k:key>.action \"<act>\"\n0.9 r1 match fact site.port => services.nginx.enable \"true\" ; services.nginx.defaultHTTPListenPort \"<value:int>\" ; services.nginx.virtualHosts.<self>.default \"true\" ; services.nginx.virtualHosts.<self>.root \"\\\"/etc/<self>\\\"\" ; services.nginx.virtualHosts.<self>.extraConfig \"\\\"index index.html;\\\"\" ; networking.firewall.allowedTCPPorts \"[ <value:int> ]\" ; environment.etc.<self>-index.target \"\\\"<self>/index.html\\\"\" ; environment.etc.<self>-index.source \"\\\"${artifact.website}/index.html\\\"\" ; environment.etc.<self>-app.target \"\\\"<self>/app.js\\\"\" ; environment.etc.<self>-app.source \"\\\"${artifact.website}/app.js\\\"\" ; artifact.website.builder \"\\\"stdenvNoCC.mkDerivation\\\"\" ; artifact.website.args.pname \"\\\"website\\\"\" ; artifact.website.args.version \"\\\"0.1.0\\\"\" ; artifact.website.args.src \"./artifacts/website\" ; artifact.website.args.dontBuild \"true\" ; artifact.website.args.installPhase \"\\\"mkdir -p $out; cp index.html app.js $out/\\\"\" ; claim.serve.run \"\\\"curl -fsS -o /dev/null -w '%{http_code}' http://localhost:<value>/\\\"\" ; claim.serve.stdout \"\\\"200\\\"\"\n0.9 r2 match fact canvas.<i> => environment.etc.<self>-canvas-<i>-name.target \"\\\"<self>/canvas/<i>/name\\\"\" ; environment.etc.<self>-canvas-<i>-name.text \"\\\"<value>\\\"\"\n0.9 r3 match fact canvas.<i>.content => environment.etc.<self>-canvas-<i>-content.target \"\\\"<self>/canvas/<i>/content\\\"\" ; environment.etc.<self>-canvas-<i>-content.text \"\\\"<value>\\\"\"\n0.9 r4 match fact button.<i> => environment.etc.<self>-button-<i>-label.target \"\\\"<self>/button/<i>/label\\\"\" ; environment.etc.<self>-button-<i>-label.text \"\\\"<value>\\\"\"\n0.9 r5 match fact button.<i>.action => environment.etc.<self>-button-<i>-action.target \"\\\"<self>/button/<i>/action\\\"\" ; environment.etc.<self>-button-<i>-action.text \"\\\"<value>\\\"\"\n0.9 q1 demand site.port \"on which port should the website be served?\"\n0.85 q2 demand canvas.<i>.content \"what does this canvas show?\"\n0.85 q3 demand button.<i>.action \"what happens when this button is clicked?\"\n0.95 a1 expect services.nginx.defaultHTTPListenPort from site.port\n0.9 a2 expect environment.etc.<self>-canvas-<i>-name.text from canvas.<i>\n0.9 a3 expect environment.etc.<self>-canvas-<i>-content.text from canvas.<i>.content\n0.9 a4 expect environment.etc.<self>-button-<i>-label.text from button.<i>\n0.9 a5 expect environment.etc.<self>-button-<i>-action.text from button.<i>.action\n0.9 s1 source website index.html <<<lips\n<!doctype html>\n<html lang=\"de\">\n<head>\n<meta charset=\"utf-8\">\n<title>website</title>\n<style>\nbody { font-family: sans-serif; margin: 2rem; }\nsvg.canvas { border: 1px solid #333; background: #fff; }\nfigcaption { color: #666; font-size: .9rem; margin-top: .3rem; }\n#controls { margin-top: 1rem; }\n#controls button { margin-right: .5rem; padding: .4rem .8rem; }\n</style>\n</head>\n<body>\n<div id=\"stage\"></div>\n<div id=\"controls\"></div>\n<script src=\"app.js\"></script>\n</body>\n</html>\nlips>>>\n0.9 s2 source website app.js <<<lips\n// The page is data driven: the canvases and the buttons are read at load\n// time from small text files the configuration writes, one file per value,\n// so adding a canvas or a button to the program needs no change here.\n\nconst MAX_ITEMS = 64;\nconst SVG_NS = \"http://www.w3.org/2000/svg\";\nconst WIDTH = 480;\nconst HEIGHT = 320;\nconst canvases = {};\n\nasync function fetchText(url) {\n  const response = await fetch(url);\n  if (!response.ok) { throw new Error(\"missing \" + url); }\n  const body = await response.text();\n  return body.replace(/\\s+$/, \"\");\n}\n\nasync function loadItems(kind, fields) {\n  const items = [];\n  for (let i = 1; i <= MAX_ITEMS; i++) {\n    const item = {};\n    try {\n      for (const field of fields) {\n        item[field] = await fetchText(\"/\" + kind + \"/\" + i + \"/\" + field);\n      }\n    } catch (e) {\n      break;\n    }\n    items.push(item);\n  }\n  return items;\n}\n\nfunction rnd(n) { return Math.floor(Math.random() * n); }\n\nfunction clear(svg) {\n  while (svg.firstChild) { svg.removeChild(svg.firstChild); }\n}\n\nfunction paint(svg) {\n  clear(svg);\n  const count = 6 + rnd(10);\n  for (let i = 0; i < count; i++) {\n    const kind = rnd(3);\n    let el;\n    if (kind === 0) {\n      el = document.createElementNS(SVG_NS, \"circle\");\n      el.setAttribute(\"cx\", rnd(WIDTH));\n      el.setAttribute(\"cy\", rnd(HEIGHT));\n      el.setAttribute(\"r\", 10 + rnd(60));\n    } else if (kind === 1) {\n      el = document.createElementNS(SVG_NS, \"rect\");\n      el.setAttribute(\"x\", rnd(WIDTH - 40));\n      el.setAttribute(\"y\", rnd(HEIGHT - 40));\n      el.setAttribute(\"width\", 20 + rnd(140));\n      el.setAttribute(\"height\", 20 + rnd(140));\n    } else {\n      el = document.createElementNS(SVG_NS, \"polygon\");\n      const points = [];\n      for (let p = 0; p < 3; p++) {\n        points.push(rnd(WIDTH) + \",\" + rnd(HEIGHT));\n      }\n      el.setAttribute(\"points\", points.join(\" \"));\n    }\n    el.setAttribute(\"fill\", \"hsl(\" + rnd(360) + \",70%,\" + (35 + rnd(40)) + \"%)\");\n    el.setAttribute(\"opacity\", (0.4 + Math.random() * 0.6).toFixed(2));\n    svg.appendChild(el);\n  }\n}\n\nfunction download(svg, name) {\n  const data = new XMLSerializer().serializeToString(svg);\n  const url = URL.createObjectURL(new Blob([data], { type: \"image/svg+xml\" }));\n  const link = document.createElement(\"a\");\n  link.href = url;\n  link.download = name + \".svg\";\n  document.body.appendChild(link);\n  link.click();\n  link.remove();\n  URL.revokeObjectURL(url);\n}\n\nfunction targetOf(action, fallback) {\n  const quoted = action.match(/\"([^\"]*)\"/);\n  if (quoted) { return quoted[1]; }\n  const named = action.match(/canvas\\s+([^\\s\".,]+)/i);\n  if (named) { return named[1]; }\n  return fallback;\n}\n\nfunction run(action) {\n  const names = Object.keys(canvases);\n  const name = targetOf(action, names[0]);\n  const svg = canvases[name];\n  if (!svg) { return; }\n  if (/erase|clear|leer|l\\u00f6sch/i.test(action)) {\n    clear(svg);\n  } else if (/download|save|speicher|herunterlad/i.test(action)) {\n    download(svg, name);\n  } else {\n    paint(svg);\n  }\n}\n\nasync function main() {\n  const stage = document.getElementById(\"stage\");\n  const controls = document.getElementById(\"controls\");\n\n  const cs = await loadItems(\"canvas\", [\"name\", \"content\"]);\n  for (const c of cs) {\n    const figure = document.createElement(\"figure\");\n    const svg = document.createElementNS(SVG_NS, \"svg\");\n    svg.setAttribute(\"class\", \"canvas\");\n    svg.setAttribute(\"width\", WIDTH);\n    svg.setAttribute(\"height\", HEIGHT);\n    svg.setAttribute(\"viewBox\", \"0 0 \" + WIDTH + \" \" + HEIGHT);\n    svg.setAttribute(\"id\", \"canvas-\" + c.name);\n    const caption = document.createElement(\"figcaption\");\n    caption.textContent = c.name + \": \" + c.content;\n    figure.appendChild(svg);\n    figure.appendChild(caption);\n    stage.appendChild(figure);\n    canvases[c.name] = svg;\n    paint(svg);\n  }\n\n  const bs = await loadItems(\"button\", [\"label\", \"action\"]);\n  for (const b of bs) {\n    const el = document.createElement(\"button\");\n    el.textContent = b.label;\n    el.addEventListener(\"click\", function () { run(b.action); });\n    controls.appendChild(el);\n  }\n}\n\nmain();\nlips>>>\n0.6 g1 gap browser-behaviour <<<lips\nblocked line: on click: new random painting in canvas \"main\"\nA click handler runs in a browser and touches the DOM. No contract reaches a\ndocument, so the behaviour cannot be written as clauses; it is baked into\napp.js, which reads the button's action text at runtime and keyword-matches\nit (erase/clear/leeren -> clear, download/speichern -> save, otherwise\nrepaint). An author who invents a fourth kind of action gets a repaint, and\nnothing in the gates catches that.\nlips>>>\n0.6 g1 because \"the action sentence is honoured by keyword matching inside baked JavaScript, not by a checked mechanism\"\n0.95 d1 report <<<lips\n## What this language says\n\nA program describes one small web page and the port it is served on:\n\n```\nwebsite running on port 8081\ncanvas \"main\":\n  content: shows a nice random svg painting\nbutton \"drück mich\":\n  on click: new random painting in canvas \"main\"\n```\n\nFour line shapes, and nothing else:\n\n- `website running on port <port>` -- the first line; it opens the page and\n  fixes the port. Everything else is written under it.\n- `canvas \"<name>\":` -- a drawing surface, named. Repeatable.\n- `content: <what it shows>` -- under a canvas; a sentence describing what is\n  drawn there, shown as the canvas caption.\n- `button \"<label>\":` -- a button, labelled. Repeatable.\n- `on click: <what happens>` -- under a button; the action sentence. The\n  canvas it names in quotes is the one it acts on.\n\n## The mechanism\n\nThe page is served by **nginx** (`services.nginx`), with\n`defaultHTTPListenPort` taken straight from the program's port and the port\nopened in the firewall. The virtual host is keyed by the program's own\ninstance name and is the default server for that port, so `curl\nlocalhost:8081` reaches it.\n\nThe page itself (`index.html` + `app.js`) is a static artifact built with\n`stdenvNoCC.mkDerivation`; it is generic and contains no value from the\nprogram. Every value the program states is instead written as its own tiny\nfile under `/etc/<instance>/` via `environment.etc` (targets\n`canvas/1/name`, `canvas/1/content`, `button/2/label`, `button/2/action`,\n...), and the document root is that directory, with the two artifact files\nlinked in beside them. `app.js` fetches `canvas/1/...`, `canvas/2/...` and so\non until one is missing, and builds the canvases and buttons from what it\nfinds.\n\nThat indirection is the point: a fill can substitute a marker but cannot\nrepeat a block of source, so baking the buttons into the HTML would have\nfrozen the button count at three. Reading them at runtime lets a human add a\nfourth button, or a second canvas, by writing two more lines -- no re-mint.\n\nCanvases and buttons are numbered by their position in the program, so two\nbuttons may share a label without colliding, and a label may contain spaces.\n\n## What is checked\n\nExpects pin every program value to the file that carries it (port ->\n`services.nginx.defaultHTTPListenPort`, each canvas name, content, button\nlabel and action -> its `environment.etc.*.text`). One claim boots the\nmachine and does `curl -w '%{http_code}' http://localhost:<port>/`, expecting\n`200`: option values alone would never prove nginx actually starts and serves\nthe root.\n\n## What I had to invent, and what is missing\n\n- The page's look (size, colours, shape mix of the random SVG) is mine; the\n  program says only \"a nice random svg painting\".\n- The click actions are interpreted inside `app.js` by keyword (erase/clear/\n  leeren, download/save/speichern, anything else repaints). This is filed as\n  the gap `browser-behaviour`: no contract reaches a browser DOM, so the\n  sentence cannot become a checked clause, and an unknown action word falls\n  back to repainting.\n- A program that omits the port, a canvas's `content:`, or a button's\n  `on click:` is asked for it rather than given a default.\nlips>>>\n"
<- submit_draft
