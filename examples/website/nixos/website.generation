t',H);at(b,'fill',col());at(b,'fill-opacity','0.2');s.appendChild(b);var m=6+rnd(14);for(var i=0;i<m;i++){s.appendChild(shape())}}function save(id){var s=document.getElementById(id);var t=new XMLSerializer().serializeToString(s);var u=URL.createObjectURL(new Blob([t],{type:'image/svg+xml'}));var a=document.createElement('a');a.href=u;a.download=id+'.svg';document.body.appendChild(a);a.click();document.body.removeChild(a);URL.revokeObjectURL(u)}function btn(t,f){var b=document.createElement('button');b.textContent=t;b.addEventListener('click',f);document.getElementById('controls').appendChild(b)}var svg=document.createElementNS(NS,'svg');at(svg,'id',CFG.canvasId);at(svg,'width',W);at(svg,'height',H);at(svg,'viewBox','0 0 '+W+' '+H);at(svg,'role','img');at(svg,'aria-label',CFG.canvasDesc);var cap=document.createElement('figcaption');cap.textContent=CFG.canvasDesc;var st=document.getElementById('stage');st.appendChild(svg);st.appendChild(cap);btn(CFG.repaintLabel,function(){paint(CFG.repaintTarget)});btn(CFG.eraseLabel,function(){clean(CFG.eraseTarget)});btn(CFG.downloadLabel,function(){save(CFG.downloadTarget)});paint(CFG.canvasId);</script></body></html>\\\"\" ; systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/canvas.js\".\"f+\".mode \"\\\"0644\\\"\" ; systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/canvas.js\".\"f+\".user \"\\\"root\\\"\" ; systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/canvas.js\".\"f+\".group \"\\\"root\\\"\" ; systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/canvas.js\".\"f+\".argument \"\\\"window.CFG.canvasId='<value>';\\\"\" ; claim.cfg.stdout \"\\\"window.CFG.canvasId='<value>';\\\"\"\n0.85 r2 because \"the served directory /var/lib/website and the whole generic page (geometry, palette, shape repertoire) are my choices; the program states only the canvas, the labels and the port\"\n0.9 r3 match fact canvas.content => systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/content.js\".\"f+\".mode \"\\\"0644\\\"\" ; systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/content.js\".\"f+\".user \"\\\"root\\\"\" ; systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/content.js\".\"f+\".group \"\\\"root\\\"\" ; systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/content.js\".\"f+\".argument \"\\\"window.CFG.canvasDesc='<value>';\\\"\"\n0.9 r4 match fact button.repaint => systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/repaint.js\".\"f+\".mode \"\\\"0644\\\"\" ; systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/repaint.js\".\"f+\".user \"\\\"root\\\"\" ; systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/repaint.js\".\"f+\".group \"\\\"root\\\"\" ; systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/repaint.js\".\"f+\".argument \"\\\"window.CFG.repaintLabel='<value.1>';window.CFG.repaintTarget='<value.2>';\\\"\"\n0.9 r5 match fact button.erase => systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/erase.js\".\"f+\".mode \"\\\"0644\\\"\" ; systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/erase.js\".\"f+\".user \"\\\"root\\\"\" ; systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/erase.js\".\"f+\".group \"\\\"root\\\"\" ; systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/erase.js\".\"f+\".argument \"\\\"window.CFG.eraseLabel='<value.1>';window.CFG.eraseTarget='<value.2>';\\\"\"\n0.9 r6 match fact button.download => systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/download.js\".\"f+\".mode \"\\\"0644\\\"\" ; systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/download.js\".\"f+\".user \"\\\"root\\\"\" ; systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/download.js\".\"f+\".group \"\\\"root\\\"\" ; systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/download.js\".\"f+\".argument \"\\\"window.CFG.downloadLabel='<value.1>';window.CFG.downloadTarget='<value.2>';\\\"\"\n0.95 q1 demand site.port \"on which TCP port should the website be served?\"\n0.9 q2 demand canvas.name \"what is the canvas called?\"\n0.9 q3 demand canvas.content \"what does the canvas show?\"\n0.9 q4 demand button.repaint \"which button label draws a new random painting, and in which canvas?\"\n0.9 q5 demand button.erase \"which button label erases a canvas, and which canvas?\"\n0.9 q6 demand button.download \"which button label downloads the picture, and from which canvas?\"\n0.95 a1 expect services.nginx.defaultHTTPListenPort from site.port\n0.9 a2 expect systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/canvas.js\".\"f+\".argument from canvas.name is \"window.CFG.canvasId='<value>';\"\n0.9 a3 expect systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/content.js\".\"f+\".argument from canvas.content is \"window.CFG.canvasDesc='<value>';\"\n0.9 a4 expect systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/repaint.js\".\"f+\".argument from button.repaint is \"window.CFG.repaintLabel='<value.1>';window.CFG.repaintTarget='<value.2>';\"\n0.9 a5 expect systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/erase.js\".\"f+\".argument from button.erase is \"window.CFG.eraseLabel='<value.1>';window.CFG.eraseTarget='<value.2>';\"\n0.9 a6 expect systemd.tmpfiles.settings.\"10-website\".\"/var/lib/website/cfg/download.js\".\"f+\".argument from button.download is \"window.CFG.downloadLabel='<value.1>';window.CFG.downloadTarget='<value.2>';\"\n0.8 g1 gap repeating-item-in-one-file <<<lips\nblocked line: button \"drück mich\":\nEach button is one <button> element and one click handler inside a single\npage. Nothing in the value grammar repeats a block of text per program item,\nso this language carries exactly one button per ACTION KIND (new painting,\nerase, download), keyed by the action rather than by the label. Repro: add a\nsecond\n  button \"noch mal\":\n    on click: new random painting in canvas \"main\"\nblock -- both on-click lines emit fact button.repaint and refinement refuses\nthe program as a conflict. The same limit fixes the language at one canvas.\nlips>>>\n0.8 g2 gap source-block-refused <<<lips\nblocked line: (the whole page)\nI first wrote the page as a source block (an artifact built from\nartifacts/website/index.html), which is the readable way to carry 60 lines of\nHTML and JavaScript. Every gate passed except one:\n  \"the language bakes source, but its generation record is missing or\n   unreadable ... website.generation\"\nso no engine that bakes source could be submitted at all. The page therefore\nlives as one single-line string literal inside rule r2, which is correct but\nhard for a human to read or diff.\nlips>>>\n0.8 g3 gap browser-observable <<<lips\nblocked line: on click: new random painting in canvas \"main\"\nWhat the program promises happens in a browser: shapes appear in an SVG\nelement, one click clears it, one click downloads it. No claim command and no\ncontract can drive a DOM event, and the program states no example output to\ncompare against, so the claims minted here stop at the boundary: nginx is\nactive, the page answers 200, and the canvas name really reaches the page's\nconfiguration. The painting code itself is held by nothing.\nlips>>>\n0.95 d1 report <<<lips\n## What a program in this language says\n\nFour line shapes are read, and every value in them is editable:\n\n- `website running on port <port>` -- the TCP port the page is served on.\n- `canvas \"<name>\":` -- names the drawing surface; the name becomes the id of\n  the SVG element on the page.\n- `content: <words...>`, written under a canvas line -- what the canvas shows.\n  The words become the SVG element's `aria-label` and the caption under it.\n- `button \"<label>\":` followed by one indented `on click: ...` line. Three\n  actions are understood; the action words select a mechanism (a handler), so\n  they are fixed vocabulary, while the label and the target canvas are values:\n  - `on click: new random painting in canvas \"<canvas>\"`\n  - `on click: erase everything in canvas \"<canvas>\"`\n  - `on click: download the picture from canvas \"<canvas>\"`\n\nAll six facts are demanded: a program that omits the port, the canvas, its\ncontent or any of the three buttons is refused with a question rather than\ncompiled into a page with an empty button on it.\n\n## The mechanism\n\nThe machine serves one static directory, `/var/lib/website`, with\n`services.nginx` (this project prefers nginx's own module over a hand-wired\nstatic server), as the default virtual host on the stated port; the port is\nalso opened in `networking.firewall`.\n\nThe directory's contents are declared, not scripted: `systemd.tmpfiles.settings`\nwrites `index.html` and five tiny JavaScript files under `cfg/`. `index.html`\nis generic -- it holds the drawing code (random circles, rectangles and\npolygons on a tinted ground, clearing, and serialising the SVG into a\ndownload) and nothing from the program. Everything the program says arrives\nthrough the `cfg/` files:\n\n- `cfg/canvas.js`  -> `window.CFG.canvasId`\n- `cfg/content.js` -> `window.CFG.canvasDesc`\n- `cfg/repaint.js`, `cfg/erase.js`, `cfg/download.js` -> each button's label\n  and the canvas it acts on\n\nThe page loads those five files and then builds the canvas and the buttons\nfrom them. This split is what makes the language work at all: each program\nline is its own decision, so each one needs its own option slot, and one file\nper line is that slot. The expects pin exactly those file contents, so\nrenaming a button in the program provably renames it on the page.\n\nThree claims run on a booted machine, because a configuration that mentions a\nweb server is not yet a web server that serves: `systemctl is-active\nnginx.service` must say `active`; a `curl` to `http://127.0.0.1:<port>/` must\nanswer `200`; and a `curl` to `/cfg/canvas.js` must return exactly the canvas\nname the program stated -- which is the whole chain, tmpfiles through nginx,\nobserved end to end.\n\n## What I chose, and what you should know\n\n- The served path `/var/lib/website` and the tmpfiles fragment name\n  `10-website` are constants, so two programs of this language on one machine\n  would collide; today there is one.\n- The page's geometry (640x400), its palette and its repertoire of shapes are\n  mine -- the program says \"a nice random svg painting\" and nothing more.\n- One canvas and one button per action kind (see the first gap).\n- The page is a single-line literal inside rule r2 rather than a readable\n  source file, because engines that bake source were refused outright (second\n  gap). Read it as minified HTML; nothing in it comes from the program.\n- Nothing observes the browser behaviour itself (third gap).\nlips>>>\n"
