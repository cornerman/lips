eElement('figure'); var svg=document.createElementNS(NS,'svg'); svg.setAttribute('class','canvas'); svg.setAttribute('width',W); svg.setAttribute('height',H); svg.setAttribute('viewBox','0 0 '+W+' '+H); svg.setAttribute('id','canvas-'+c.name); var cap=document.createElement('figcaption'); cap.textContent=c.name+': '+c.content; fig.appendChild(svg); fig.appendChild(cap); stage.appendChild(fig); canvases[c.name]=svg; paint(svg); } var bs=await loadItems('button',['label','action']); for(var b of bs){ (function(item){ var el=document.createElement('button'); el.textContent=item.label; el.addEventListener('click',function(){ act(item.action); }); controls.appendChild(el); })(b); } } main();\\\"\" ; claim.serve.run \"\\\"curl -fsS -o /dev/null -w '%{http_code}' http://localhost:<value>/\\\"\" ; claim.serve.stdout \"\\\"200\\\"\"\n0.9 r2 match fact canvas.<i> => environment.etc.<self>-canvas-<i>-name.target \"\\\"<self>/canvas/<i>/name\\\"\" ; environment.etc.<self>-canvas-<i>-name.text \"\\\"<value>\\\"\"\n0.9 r3 match fact canvas.<i>.content => environment.etc.<self>-canvas-<i>-content.target \"\\\"<self>/canvas/<i>/content\\\"\" ; environment.etc.<self>-canvas-<i>-content.text \"\\\"<value>\\\"\"\n0.9 r4 match fact button.<i> => environment.etc.<self>-button-<i>-label.target \"\\\"<self>/button/<i>/label\\\"\" ; environment.etc.<self>-button-<i>-label.text \"\\\"<value>\\\"\"\n0.9 r5 match fact button.<i>.action => environment.etc.<self>-button-<i>-action.target \"\\\"<self>/button/<i>/action\\\"\" ; environment.etc.<self>-button-<i>-action.text \"\\\"<value>\\\"\"\n0.9 q1 demand site.port \"on which port should the website be served?\"\n0.85 q2 demand canvas.<i>.content \"what does this canvas show?\"\n0.85 q3 demand button.<i>.action \"what happens when this button is clicked?\"\n0.95 a1 expect services.nginx.defaultHTTPListenPort from site.port\n0.9 a2 expect environment.etc.<self>-canvas-<i>-name.text from canvas.<i>\n0.9 a3 expect environment.etc.<self>-canvas-<i>-content.text from canvas.<i>.content\n0.9 a4 expect environment.etc.<self>-button-<i>-label.text from button.<i>\n0.9 a5 expect environment.etc.<self>-button-<i>-action.text from button.<i>.action\n0.85 r1 because \"the page shell and its script are mechanism, not program values, so they are fixed text; only the port, the canvases and the buttons come from the program\"\n0.6 g1 gap browser-behaviour <<<lips\nblocked line: on click: new random painting in canvas \"main\"\nA click handler runs in a browser and touches the DOM. No contract reaches a\ndocument, so the behaviour cannot be written as clauses, and a source block\nwas refused here (the generation record a baked source is checked against is\nnot readable), so the page script is carried as fixed text in an\nenvironment.etc entry. It reads each button's action sentence at runtime and\nkeyword-matches it (erase/clear/leeren -> wipe, download/save/speichern ->\nsave, anything else -> repaint). An author who invents a fourth kind of\naction gets a repaint, and no gate catches that.\nlips>>>\n0.95 d1 report <<<lips\n## What this language says\n\nA program describes one small web page and the port it is served on:\n\n```\nwebsite running on port 8081\ncanvas \"main\":\n  content: shows a nice random svg painting\nbutton \"drück mich\":\n  on click: new random painting in canvas \"main\"\n```\n\nFive line shapes, and nothing else:\n\n- `website running on port <port>` -- the first line; it opens the page and\n  fixes the port. Every other line is read as belonging to it.\n- `canvas \"<name>\":` -- a drawing surface, named. Repeatable.\n- `content: <what it shows>` -- under a canvas; shown as its caption.\n- `button \"<label>\":` -- a button, labelled. Repeatable.\n- `on click: <what happens>` -- under a button; the action sentence. The\n  canvas it names in quotes is the one it acts on.\n\nCanvases and buttons are numbered by their position in the program, so two\nbuttons may share a label, and a label may contain spaces (`\"drück mich\"`).\n\n## The mechanism\n\nThe page is served by **nginx**: `services.nginx.defaultHTTPListenPort` is\nthe program's port, the port is opened in the firewall, and the virtual host\n-- keyed by the program's own instance name -- is the default server for that\nport, so `curl localhost:8081` reaches it. nginx builds its own config, so\nno listen address is hand-written anywhere.\n\nThe document root is `/etc/<instance>/`, assembled out of `environment.etc`\nentries. Two of them are fixed text: `index.html` (an empty page shell) and\n`app.js`. Every value the program states becomes its own tiny file beside\nthem: `canvas/1/name`, `canvas/1/content`, `button/2/label`,\n`button/2/action`, and so on. `app.js` fetches `canvas/1/...`,\n`canvas/2/...`, `button/1/...` until one is missing, and builds the canvases\nand the buttons out of what it finds.\n\nThat indirection is deliberate. If the buttons were written into the HTML,\ntheir number would be frozen at three: nothing in lips repeats a block of\ntext per item. Reading them at runtime means a human adds a fourth button, or\na second canvas, by writing two more lines -- no re-mint, no rebuild.\n\n`app.js` draws the random painting (circles, rectangles and triangles in\nrandom hues on an SVG surface), and decides what a click does by reading the\nbutton's own action sentence: *erase/clear/leeren* wipes the canvas,\n*download/save/speichern* downloads it as an `.svg` file, anything else\npaints a new picture. The canvas named in quotes in that sentence is the one\nacted on.\n\n## What is checked\n\nExpects pin every program value to the file that carries it: the port to\n`services.nginx.defaultHTTPListenPort`, and each canvas name, canvas\ncontent, button label and button action to its `environment.etc.*.text`.\nOne claim boots the machine and runs\n`curl -w '%{http_code}' http://localhost:<port>/`, expecting `200` --\noption values alone would never show that nginx really starts and really\nserves that root.\n\n## What I invented, and what is missing\n\n- The look of the page and the shape of the random painting are mine; the\n  program says only \"a nice random svg painting\".\n- Click behaviour is keyword-matched inside `app.js`. This is filed as the\n  gap `browser-behaviour`: no contract reaches a browser DOM, so the\n  sentence cannot become a checked clause, and an action word outside the\n  three families above silently repaints.\n- A program that omits the port, a canvas's `content:` or a button's\n  `on click:` is asked for it rather than given a default.\nlips>>>\n" true
