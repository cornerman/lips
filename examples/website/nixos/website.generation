ton-<i>-label.target \"\\\"<self>/button/<i>/label\\\"\" ; environment.etc.<self>-button-<i>-label.text \"\\\"<value>\\\"\"\n0.9 r5 match fact button.<i>.action => environment.etc.<self>-button-<i>-action.target \"\\\"<self>/button/<i>/action\\\"\" ; environment.etc.<self>-button-<i>-action.text \"\\\"<value>\\\"\"\n0.9 q1 demand site.port \"on which port should the website be served?\"\n0.85 q2 demand canvas.<i>.content \"what does this canvas show?\"\n0.85 q3 demand button.<i>.action \"what happens when this button is clicked?\"\n0.95 a1 expect services.nginx.defaultHTTPListenPort from site.port\n0.9 a2 expect environment.etc.<self>-canvas-<i>-name.text from canvas.<i>\n0.9 a3 expect environment.etc.<self>-canvas-<i>-content.text from canvas.<i>.content\n0.9 a4 expect environment.etc.<self>-button-<i>-label.text from button.<i>\n0.9 a5 expect environment.etc.<self>-button-<i>-action.text from button.<i>.action\n0.85 r1 because \"the page shell and its script are mechanism, not program values; only the port, the canvases and the buttons come from the program\"\n0.9 s1 source website index.html <<<lips\n<!doctype html>\n<html lang=\"de\">\n<head>\n<meta charset=\"utf-8\">\n<title>website</title>\n<style>\nbody { font-family: sans-serif; margin: 2rem; }\nsvg.canvas { border: 1px solid #333; background: #fff; }\nfigcaption { color: #666; font-size: .9rem; margin-top: .3rem; }\n#controls { margin-top: 1rem; }\n#controls button { margin-right: .5rem; padding: .4rem .8rem; }\n</style>\n</head>\n<body>\n<div id=\"stage\"></div>\n<div id=\"controls\"></div>\n<script src=\"app.js\"></script>\n</body>\n</html>\nlips>>>\n0.9 s2 source website app.js <<<lips\n// The page is data driven: the canvases and the buttons are read at load\n// time from small text files the configuration writes, one file per value,\n// so adding a canvas or a button to the program needs no change here.\n\nconst MAX_ITEMS = 64;\nconst SVG_NS = \"http://www.w3.org/2000/svg\";\nconst WIDTH = 480;\nconst HEIGHT = 320;\nconst QUOTE = String.fromCharCode(34);\nconst canvases = {};\n\nasync function fetchText(url) {\n  const response = await fetch(url);\n  if (!response.ok) { throw new Error(\"missing \" + url); }\n  const body = await response.text();\n  return body.trim();\n}\n\nasync function loadItems(kind, fields) {\n  const items = [];\n  for (let i = 1; i <= MAX_ITEMS; i++) {\n    const item = {};\n    try {\n      for (const field of fields) {\n        item[field] = await fetchText(\"/\" + kind + \"/\" + i + \"/\" + field);\n      }\n    } catch (e) {\n      break;\n    }\n    items.push(item);\n  }\n  return items;\n}\n\nfunction rnd(n) { return Math.floor(Math.random() * n); }\n\nfunction wipe(svg) {\n  while (svg.firstChild) { svg.removeChild(svg.firstChild); }\n}\n\nfunction paint(svg) {\n  wipe(svg);\n  const count = 6 + rnd(10);\n  for (let i = 0; i < count; i++) {\n    const kind = rnd(3);\n    let el;\n    if (kind === 0) {\n      el = document.createElementNS(SVG_NS, \"circle\");\n      el.setAttribute(\"cx\", rnd(WIDTH));\n      el.setAttribute(\"cy\", rnd(HEIGHT));\n      el.setAttribute(\"r\", 10 + rnd(60));\n    } else if (kind === 1) {\n      el = document.createElementNS(SVG_NS, \"rect\");\n      el.setAttribute(\"x\", rnd(WIDTH - 40));\n      el.setAttribute(\"y\", rnd(HEIGHT - 40));\n      el.setAttribute(\"width\", 20 + rnd(140));\n      el.setAttribute(\"height\", 20 + rnd(140));\n    } else {\n      el = document.createElementNS(SVG_NS, \"polygon\");\n      const points = [];\n      for (let p = 0; p < 3; p++) {\n        points.push(rnd(WIDTH) + \",\" + rnd(HEIGHT));\n      }\n      el.setAttribute(\"points\", points.join(\" \"));\n    }\n    el.setAttribute(\"fill\", \"hsl(\" + rnd(360) + \",70%,\" + (35 + rnd(40)) + \"%)\");\n    el.setAttribute(\"opacity\", (0.4 + Math.random() * 0.6).toFixed(2));\n    svg.appendChild(el);\n  }\n}\n\nfunction save(svg, name) {\n  const data = new XMLSerializer().serializeToString(svg);\n  const url = URL.createObjectURL(new Blob([data], { type: \"image/svg+xml\" }));\n  const link = document.createElement(\"a\");\n  link.href = url;\n  link.download = name + \".svg\";\n  document.body.appendChild(link);\n  link.click();\n  link.remove();\n  URL.revokeObjectURL(url);\n}\n\nfunction targetOf(action, fallback) {\n  const i = action.indexOf(QUOTE);\n  if (i >= 0) {\n    const j = action.indexOf(QUOTE, i + 1);\n    if (j > i) { return action.substring(i + 1, j); }\n  }\n  const words = action.split(\" \");\n  const k = words.indexOf(\"canvas\");\n  if (k >= 0 && words[k + 1]) { return words[k + 1]; }\n  return fallback;\n}\n\nfunction act(action) {\n  const names = Object.keys(canvases);\n  const name = targetOf(action, names[0]);\n  const svg = canvases[name];\n  if (!svg) { return; }\n  const a = action.toLowerCase();\n  if (a.indexOf(\"erase\") >= 0 || a.indexOf(\"clear\") >= 0 || a.indexOf(\"leer\") >= 0) {\n    wipe(svg);\n  } else if (a.indexOf(\"download\") >= 0 || a.indexOf(\"save\") >= 0 || a.indexOf(\"speicher\") >= 0) {\n    save(svg, name);\n  } else {\n    paint(svg);\n  }\n}\n\nasync function main() {\n  const stage = document.getElementById(\"stage\");\n  const controls = document.getElementById(\"controls\");\n\n  const cs = await loadItems(\"canvas\", [\"name\", \"content\"]);\n  for (const c of cs) {\n    const figure = document.createElement(\"figure\");\n    const svg = document.createElementNS(SVG_NS, \"svg\");\n    svg.setAttribute(\"class\", \"canvas\");\n    svg.setAttribute(\"width\", WIDTH);\n    svg.setAttribute(\"height\", HEIGHT);\n    svg.setAttribute(\"viewBox\", \"0 0 \" + WIDTH + \" \" + HEIGHT);\n    svg.setAttribute(\"id\", \"canvas-\" + c.name);\n    const caption = document.createElement(\"figcaption\");\n    caption.textContent = c.name + \": \" + c.content;\n    figure.appendChild(svg);\n    figure.appendChild(caption);\n    stage.appendChild(figure);\n    canvases[c.name] = svg;\n    paint(svg);\n  }\n\n  const bs = await loadItems(\"button\", [\"label\", \"action\"]);\n  for (const b of bs) {\n    const el = document.createElement(\"button\");\n    el.textContent = b.label;\n    el.addEventListener(\"click\", function () { act(b.action); });\n    controls.appendChild(el);\n  }\n}\n\nmain();\nlips>>>\n0.6 g1 gap browser-behaviour <<<lips\nblocked line: on click: new random painting in canvas \"main\"\nA click handler runs in a browser and touches the DOM. No contract reaches a\ndocument, so the behaviour cannot be written as clauses; it is baked into\napp.js, which reads each button's action sentence at runtime and\nkeyword-matches it (erase/clear/leeren -> wipe, download/save/speichern ->\nsave, anything else -> repaint). An author who invents a fourth kind of\naction gets a repaint, and no gate catches that.\n\nSecond, smaller repro: markup cannot travel through a rule at all.\n  match fact page.shell => environment.etc.page.text \"\\\"<p id='x'>hi</p>\\\"\"\nis refused with \"unknown hole <p id='x'>\", because every <...> in a value is\nread as a hole. So any language whose output is HTML must bake a source file\neven when the file is three lines long.\nlips>>>\n0.95 d1 report <<<lips\n## What this language says\n\nA program describes one small web page and the port it is served on:\n\n```\nwebsite running on port 8081\ncanvas \"main\":\n  content: shows a nice random svg painting\nbutton \"drück mich\":\n  on click: new random painting in canvas \"main\"\n```\n\nFive line shapes, and nothing else:\n\n- `website running on port <port>` -- the first line; it opens the page and\n  fixes the port. Every other line is read as belonging to it.\n- `canvas \"<name>\":` -- a drawing surface, named. Repeatable.\n- `content: <what it shows>` -- under a canvas; shown as its caption.\n- `button \"<label>\":` -- a button, labelled. Repeatable.\n- `on click: <what happens>` -- under a button; the action sentence. The\n  canvas it names in quotes is the one it acts on.\n\nCanvases and buttons are numbered by their position in the program, so two\nbuttons may share a label, and a label may contain spaces (`\"drück mich\"`).\n\n## The mechanism\n\nThe page is served by **nginx**: `services.nginx.defaultHTTPListenPort` is\nthe program's port, the port is opened in the firewall, and the virtual host\n-- keyed by the program's own instance name -- is the default server for that\nport, so `curl localhost:8081` reaches it. The nginx module builds its own\nconfig, so no listen address is hand-written anywhere.\n\nThe document root is `/etc/<instance>/`, assembled out of `environment.etc`\nentries. Two of them come from a built artifact, an ordinary static bundle:\n`index.html` (an empty page shell) and `app.js`. Every value the program\nstates becomes its own tiny text file beside them: `canvas/1/name`,\n`canvas/1/content`, `button/2/label`, `button/2/action`, and so on. `app.js`\nfetches `canvas/1/...`, `canvas/2/...`, `button/1/...` until one is missing,\nand builds the canvases and the buttons out of what it finds.\n\nThat indirection is deliberate. If the buttons were written into the HTML,\ntheir number would be frozen at three: nothing in lips repeats a block of\nsource text per item, so a fourth button would have cost a fresh mint.\nReading them at runtime means a human adds a button, or a second canvas, by\nwriting two more lines.\n\n`app.js` draws the painting (circles, rectangles and triangles in random\nhues on an SVG surface), and decides what a click does by reading the\nbutton's own action sentence: *erase/clear/leeren* wipes the canvas,\n*download/save/speichern* downloads it as an `.svg` file, anything else\npaints a new picture. The canvas named in quotes in that sentence is the one\nacted on.\n\n## What is checked\n\nExpects pin every program value to the file that carries it: the port to\n`services.nginx.defaultHTTPListenPort`, and each canvas name, canvas\ncontent, button label and button action to its `environment.etc.*.text`.\nOne claim boots the machine and runs\n`curl -w '%{http_code}' http://localhost:<port>/`, expecting `200` --\noption values alone would never show that nginx really starts and really\nserves that root.\n\n## What I invented, and what is missing\n\n- The look of the page and the shape of the random painting are mine; the\n  program says only \"a nice random svg painting\".\n- Click behaviour is keyword-matched inside `app.js`. This is filed as the\n  gap `browser-behaviour`: no contract reaches a browser DOM, so the\n  sentence cannot become a checked clause, and an action word outside the\n  three families above silently repaints.\n- A program that omits the port, a canvas's `content:` or a button's\n  `on click:` is asked for it rather than given a default.\nlips>>>\n" true
