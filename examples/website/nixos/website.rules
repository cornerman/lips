r1 meta engine.rule.r1 stated "match fact site.port => services.nginx.enable \"true\" ; services.nginx.defaultHTTPListenPort \"<value:int>\" ; services.nginx.virtualHosts.<self>.default \"true\" ; services.nginx.virtualHosts.<self>.root \"\\\"/var/lib/<self>-www\\\"\" ; services.nginx.virtualHosts.<self>.extraConfig \"\\\"index index.html;\\\"\" ; networking.firewall.allowedTCPPorts \"[ <value:int> ]\" ; environment.systemPackages \"[ ${site} ]\" ; site.<self>.command \"\\\"<self>\\\"\" ; systemd.services.<self>-page.description \"\\\"lay out the website document root\\\"\" ; systemd.services.<self>-page.wantedBy \"[ \\\"multi-user.target\\\" ]\" ; systemd.services.<self>-page.before \"[ \\\"nginx.service\\\" ]\" ; systemd.services.<self>-page.serviceConfig.Type \"\\\"oneshot\\\"\" ; systemd.services.<self>-page.serviceConfig.RemainAfterExit \"true\" ; systemd.services.<self>-page.script \"\\\"rm -rf /var/lib/<self>-www; install -d -m 0755 /var/lib/<self>-www /var/lib/<self>-www/data; cp -rLT /etc/<self> /var/lib/<self>-www/data || true; ${site}/bin/<self> > /var/lib/<self>-www/index.html; chmod -R a+rX /var/lib/<self>-www\\\"\" ; clause.website-page-text \"(define (website-page-text) \\\"<!doctype html><html lang='de'><head><meta charset='utf-8'><title>website</title><style>body{font-family:sans-serif;margin:2rem} svg.canvas{border:1px solid #333;background:#fff} figcaption{color:#666;font-size:.9rem;margin-top:.3rem} #controls{margin-top:1rem} #controls button{margin-right:.5rem;padding:.4rem .8rem}</style></head><body><div id='stage'></div><div id='controls'></div><script>var MAX=64; var NS='http://www.w3.org/2000/svg'; var W=480; var H=320; var Q=String.fromCharCode(34); var canvases={}; function rnd(n){ return Math.floor(Math.random()*n); } async function get(u){ var r=await fetch(u); if(!r.ok){ throw new Error('missing'); } var t=await r.text(); return t.trim(); } async function loadItems(kind,fields){ var items=[]; for(var i=1;i<=MAX;i++){ var item={}; try { for(var f of fields){ item[f]=await get('/data/'+kind+'/'+i+'/'+f); } } catch(e){ break; } items.push(item); } return items; } function wipe(svg){ while(svg.firstChild){ svg.removeChild(svg.firstChild); } } function paint(svg){ wipe(svg); var n=6+rnd(10); for(var i=0;i<n;i++){ var k=rnd(3); var el; if(k===0){ el=document.createElementNS(NS,'circle'); el.setAttribute('cx',rnd(W)); el.setAttribute('cy',rnd(H)); el.setAttribute('r',10+rnd(60)); } else if(k===1){ el=document.createElementNS(NS,'rect'); el.setAttribute('x',rnd(W-40)); el.setAttribute('y',rnd(H-40)); el.setAttribute('width',20+rnd(140)); el.setAttribute('height',20+rnd(140)); } else { el=document.createElementNS(NS,'polygon'); var p=[]; for(var j=0;j<3;j++){ p.push(rnd(W)+','+rnd(H)); } el.setAttribute('points',p.join(' ')); } el.setAttribute('fill','hsl('+rnd(360)+',70%,'+(35+rnd(40))+'%)'); el.setAttribute('opacity',(0.4+Math.random()*0.6).toFixed(2)); svg.appendChild(el); } } function save(svg,name){ var data=new XMLSerializer().serializeToString(svg); var url=URL.createObjectURL(new Blob([data],{type:'image/svg+xml'})); var a=document.createElement('a'); a.href=url; a.download=name+'.svg'; document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url); } function targetOf(action,fallback){ var i=action.indexOf(Q); if(i>=0){ var j=action.indexOf(Q,i+1); if(j>i){ return action.substring(i+1,j); } } var w=action.split(' '); var k=w.indexOf('canvas'); if(k>=0&&w[k+1]){ return w[k+1]; } return fallback; } function act(action){ var names=Object.keys(canvases); var name=targetOf(action,names[0]); var svg=canvases[name]; if(!svg){ return; } var a=action.toLowerCase(); if(a.indexOf('erase')>=0||a.indexOf('clear')>=0||a.indexOf('leer')>=0){ wipe(svg); } else if(a.indexOf('download')>=0||a.indexOf('save')>=0||a.indexOf('speicher')>=0){ save(svg,name); } else { paint(svg); } } async function main(){ var stage=document.getElementById('stage'); var controls=document.getElementById('controls'); var cs=await loadItems('canvas',['name','content']); for(var c of cs){ var fig=document.createElement('figure'); var svg=document.createElementNS(NS,'svg'); svg.setAttribute('class','canvas'); svg.setAttribute('width',W); svg.setAttribute('height',H); svg.setAttribute('viewBox','0 0 '+W+' '+H); svg.setAttribute('id','canvas-'+c.name); var cap=document.createElement('figcaption'); cap.textContent=c.name+': '+c.content; fig.appendChild(svg); fig.appendChild(cap); stage.appendChild(fig); canvases[c.name]=svg; paint(svg); } var bs=await loadItems('button',['label','action']); for(var b of bs){ (function(item){ var el=document.createElement('button'); el.textContent=item.label; el.addEventListener('click',function(){ act(item.action); }); controls.appendChild(el); })(b); } } main();</script></body></html>\\\")\" ; clause.website-main \"(define (website-main) (emit (website-page-text)))\" ; claim.page.call \"(begin (website-main) (length (emitted)))\" ; claim.page.equals \"1\" ; claim.doctype.call \"(substring (website-page-text) 2 9)\" ; claim.doctype.equals \"\\\"doctype\\\"\" ; claim.serve.run \"\\\"curl -fsS -o /dev/null -w '%{http_code}' http://localhost:<value>/\\\"\" ; claim.serve.stdout \"\\\"200\\\"\"" @gen:34fc9eb7132f6493
r2 meta engine.rule.r2 stated "match fact canvas.<i> => environment.etc.website-canvas-<i>-name.target \"\\\"<self>/canvas/<i>/name\\\"\" ; environment.etc.website-canvas-<i>-name.text \"\\\"<value>\\\"\"" @gen:34fc9eb7132f6493
r3 meta engine.rule.r3 stated "match fact canvas.<i>.content => environment.etc.website-canvas-<i>-content.target \"\\\"<self>/canvas/<i>/content\\\"\" ; environment.etc.website-canvas-<i>-content.text \"\\\"<value>\\\"\"" @gen:34fc9eb7132f6493
r4 meta engine.rule.r4 stated "match fact button.<i> => environment.etc.website-button-<i>-label.target \"\\\"<self>/button/<i>/label\\\"\" ; environment.etc.website-button-<i>-label.text \"\\\"<value>\\\"\"" @gen:34fc9eb7132f6493
r5 meta engine.rule.r5 stated "match fact button.<i>.action => environment.etc.website-button-<i>-action.target \"\\\"<self>/button/<i>/action\\\"\" ; environment.etc.website-button-<i>-action.text \"\\\"<value>\\\"\"" @gen:34fc9eb7132f6493
