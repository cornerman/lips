q1 meta engine.demand.q1 stated "demand site.port \"on which TCP port should the website be served?\"" @gen:56a2b4a35ccdc4b4
q2 meta engine.demand.q2 stated "demand canvas.name \"what is the canvas called?\"" @gen:56a2b4a35ccdc4b4
q3 meta engine.demand.q3 stated "demand canvas.content \"what does the canvas show?\"" @gen:56a2b4a35ccdc4b4
q4 meta engine.demand.q4 stated "demand button.repaint \"which button label draws a new random painting, and in which canvas?\"" @gen:56a2b4a35ccdc4b4
q5 meta engine.demand.q5 stated "demand button.erase \"which button label erases a canvas, and which canvas?\"" @gen:56a2b4a35ccdc4b4
q6 meta engine.demand.q6 stated "demand button.download \"which button label downloads the picture, and from which canvas?\"" @gen:56a2b4a35ccdc4b4
r1 meta engine.rule.r1 stated "match fact site.port => services.nginx.enable \"true\" ; services.nginx.defaultHTTPListenPort \"<value:int>\" ; services.darkhttpd.port \"<value:int>\" ; networking.firewall.allowedTCPPorts \"[ <value:int> ]\" ; claim.up.run \"\\\"systemctl is-active nginx.service\\\"\" ; claim.up.stdout \"\\\"active\\\"\" ; claim.serves.run \"\\\"${pkgs.curl}/bin/curl -fsS -o /dev/null -w '%{http_code}' http://127.0.0.1:<value>/\\\"\" ; claim.serves.stdout \"\\\"200\\\"\"" @gen:56a2b4a35ccdc4b4
r2 meta engine.rule.r2 stated "match fact canvas.name => clause.website-canvas-id \"(define (website-canvas-id) \\\"#<value>\\\")\" ; clause.website-page \"(define (website-page) (string-append \\\"<!DOCTYPE html><html lang='de'><head><meta charset='utf-8'><title>\\\" (website-canvas-id) \\\"</title><style>body{font-family:sans-serif;margin:2rem;background:rgb(246,246,246)}svg{border:1px solid rgb(136,136,136);background:rgb(255,255,255);display:block}figcaption{color:rgb(85,85,85);margin-top:0.4rem}button{margin-right:0.5rem;font-size:1rem;padding:0.4rem 0.9rem}</style></head><body><figure><svg id='\\\" (website-canvas-id) \\\"' width='640' height='400' viewBox='0 0 640 400' role='img' aria-label='\\\" (website-canvas-desc) \\\"'></svg><figcaption>\\\" (website-canvas-desc) \\\"</figcaption></figure><p><button id='b1'>\\\" (website-repaint-label) \\\"</button><button id='b2'>\\\" (website-erase-label) \\\"</button><button id='b3'>\\\" (website-download-label) \\\"</button></p><script>var NS='http://www.w3.org/2000/svg';var W=640;var H=400;function rnd(n){return Math.floor(Math.random()*n)}function col(){return 'rgb('+rnd(256)+','+rnd(256)+','+rnd(256)+')'}function at(e,k,v){e.setAttribute(k,v)}function shape(){var k=['circle','rect','polygon'][rnd(3)];var e=document.createElementNS(NS,k);if(k=='circle'){at(e,'cx',rnd(W));at(e,'cy',rnd(H));at(e,'r',10+rnd(120))}else if(k=='rect'){at(e,'x',rnd(W));at(e,'y',rnd(H));at(e,'width',20+rnd(200));at(e,'height',20+rnd(150))}else{var p=[];var m=3+rnd(4);for(var i=m;i--;){p.push(rnd(W)+','+rnd(H))}at(e,'points',p.join(' '))}at(e,'fill',col());at(e,'fill-opacity','0.55');at(e,'stroke',col());at(e,'stroke-width',1+rnd(4));return e}function clean(id){var s=document.getElementById(id);while(s.firstChild){s.removeChild(s.firstChild)}}function paint(id){var s=document.getElementById(id);clean(id);var b=document.createElementNS(NS,'rect');at(b,'x',0);at(b,'y',0);at(b,'width',W);at(b,'height',H);at(b,'fill',col());at(b,'fill-opacity','0.2');s.appendChild(b);var m=6+rnd(14);for(var i=m;i--;){s.appendChild(shape())}}function save(id){var s=document.getElementById(id);var t=new XMLSerializer().serializeToString(s);var u=URL.createObjectURL(new Blob([t],{type:'image/svg+xml'}));var a=document.createElement('a');a.href=u;a.download=id+'.svg';document.body.appendChild(a);a.click();document.body.removeChild(a);URL.revokeObjectURL(u)}document.getElementById('b1').addEventListener('click',function(){paint('\\\" (website-repaint-target) \\\"')});document.getElementById('b2').addEventListener('click',function(){clean('\\\" (website-erase-target) \\\"')});document.getElementById('b3').addEventListener('click',function(){save('\\\" (website-download-target) \\\"')});paint('\\\" (website-canvas-id) \\\"');</script></body></html>\\\"))\" ; clause.website-main \"(define (website-main) (emit (website-page)))\" ; claim.canvasid.call \"(website-canvas-id)\" ; claim.canvasid.equals \"\\\"<value>\\\"\" ; claim.page.call \"(begin (website-main) (equal? (car (emitted)) (website-page)))\" ; claim.page.equals \"#t\" ; site.<self>.command \"\\\"website-render\\\"\" ; environment.systemPackages \"[ ${site} ]\" ; systemd.services.<self>.description \"\\\"render the painting page\\\"\" ; systemd.services.<self>.wantedBy \"[ \\\"multi-user.target\\\" ]\" ; systemd.services.<self>.before \"[ \\\"nginx.service\\\" ]\" ; systemd.services.<self>.path \"[ ${site} ]\" ; systemd.services.<self>.script \"\\\"website-render > /var/lib/website/index.html\\\"\" ; systemd.services.<self>.serviceConfig.Type \"\\\"oneshot\\\"\" ; systemd.services.<self>.serviceConfig.RemainAfterExit \"true\" ; systemd.services.<self>.serviceConfig.StateDirectory \"\\\"website\\\"\" ; services.nginx.virtualHosts.<self>.root \"\\\"/var/lib/website\\\"\" ; services.nginx.virtualHosts.<self>.default \"true\"" @gen:56a2b4a35ccdc4b4
r3 meta engine.rule.r3 stated "match fact canvas.content => clause.website-canvas-desc \"(define (website-canvas-desc) \\\"#<value>\\\")\" ; claim.canvasdesc.call \"(website-canvas-desc)\" ; claim.canvasdesc.equals \"\\\"<value>\\\"\"" @gen:56a2b4a35ccdc4b4
r4 meta engine.rule.r4 stated "match fact button.repaint => clause.website-repaint-label \"(define (website-repaint-label) \\\"#<value.1>\\\")\" ; clause.website-repaint-target \"(define (website-repaint-target) \\\"#<value.2>\\\")\" ; claim.repaintlabel.call \"(website-repaint-label)\" ; claim.repaintlabel.equals \"\\\"<value.1>\\\"\" ; claim.repainttarget.call \"(website-repaint-target)\" ; claim.repainttarget.equals \"\\\"<value.2>\\\"\"" @gen:56a2b4a35ccdc4b4
r5 meta engine.rule.r5 stated "match fact button.erase => clause.website-erase-label \"(define (website-erase-label) \\\"#<value.1>\\\")\" ; clause.website-erase-target \"(define (website-erase-target) \\\"#<value.2>\\\")\" ; claim.eraselabel.call \"(website-erase-label)\" ; claim.eraselabel.equals \"\\\"<value.1>\\\"\" ; claim.erasetarget.call \"(website-erase-target)\" ; claim.erasetarget.equals \"\\\"<value.2>\\\"\"" @gen:56a2b4a35ccdc4b4
r6 meta engine.rule.r6 stated "match fact button.download => clause.website-download-label \"(define (website-download-label) \\\"#<value.1>\\\")\" ; clause.website-download-target \"(define (website-download-target) \\\"#<value.2>\\\")\" ; claim.downloadlabel.call \"(website-download-label)\" ; claim.downloadlabel.equals \"\\\"<value.1>\\\"\" ; claim.downloadtarget.call \"(website-download-target)\" ; claim.downloadtarget.equals \"\\\"<value.2>\\\"\"" @gen:56a2b4a35ccdc4b4
