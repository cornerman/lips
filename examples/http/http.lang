p1 meta lang.pattern.p1 stated "serve http on port <port> => fact server.port \"<port>\"" @gen:095860b24c7f2ebf
p2 meta lang.pattern.p2 stated "run it as a systemd service named <name> => concept server.<name> \"the http server this program describes\" ; fact service.<name>.alias \"<name>\"" @gen:095860b24c7f2ebf
p3 meta lang.pattern.p3 stated "routes => concept routes \"the routes this server answers\"" @gen:095860b24c7f2ebf
p4 meta lang.pattern.p4.under.p2 stated "- <path> answers with the text <body> => fact route.<name>.<path>.text \"<body>\"" @gen:095860b24c7f2ebf
q1 meta engine.demand.q1 stated "demand server.port \"which TCP port should the http server listen on?\"" @gen:095860b24c7f2ebf
q2 meta engine.demand.q2 stated "demand service.<name>.alias \"what should the systemd service be called?\"" @gen:095860b24c7f2ebf
r1 meta engine.rule.r1 stated "match fact server.port => services.nginx.enable \"true\" ; services.nginx.defaultHTTPListenPort \"<value:int>\" ; networking.firewall.allowedTCPPorts \"[ <value:int> ]\"" @gen:095860b24c7f2ebf
r2 meta engine.rule.r2 stated "match fact service.<name>.alias => systemd.services.nginx.aliases \"[ \\\"<value>.service\\\" ]\"" @gen:095860b24c7f2ebf
r3 meta engine.rule.r3 stated "match fact route.<name>.<path>.text => services.nginx.virtualHosts.<name>.locations.<path>.extraConfig \"\\\"default_type text/plain; return 200 '<value>';\\\"\"" @gen:095860b24c7f2ebf
