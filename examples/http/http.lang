r1 meta engine.rule.r1 stated "match fact server.port => artifact.<self>.builder \"\\\"buildGoModule\\\"\" ; artifact.<self>.args.pname \"\\\"httpserve\\\"\" ; artifact.<self>.args.version \"\\\"0.1.0\\\"\" ; artifact.<self>.args.src \"./artifacts/<self>\" ; artifact.<self>.args.vendorHash \"null\" ; artifact.<self>.fill.port \"\\\"<value>\\\"\" ; networking.firewall.allowedTCPPorts \"[ <value:int> ]\"" @gen:e15df3fc754da1eb
r2 meta engine.rule.r2 stated "match fact server.response => artifact.<self>.fill.body \"\\\"<value>\\\"\"" @gen:e15df3fc754da1eb
r3 meta engine.rule.r3 stated "match fact service.<name> => systemd.services.<name>.description \"\\\"http responder <value>\\\"\" ; systemd.services.<name>.after \"[ \\\"network.target\\\" ]\" ; systemd.services.<name>.wantedBy \"[ \\\"multi-user.target\\\" ]\" ; systemd.services.<name>.serviceConfig.ExecStart \"\\\"${artifact.<self>}/bin/httpserve\\\"\" ; systemd.services.<name>.serviceConfig.Restart \"\\\"always\\\"\" ; systemd.services.<name>.serviceConfig.DynamicUser \"true\" ; systemd.services.<name>.serviceConfig.AmbientCapabilities \"\\\"CAP_NET_BIND_SERVICE\\\"\" ; systemd.services.<name>.serviceConfig.SyslogIdentifier \"\\\"<value>\\\"\"" @gen:e15df3fc754da1eb
r4 meta engine.rule.r4 stated "match fact witness.<path>.body => claim.serve.run \"\\\"${artifact.<self>}/bin/httpserve -check <path>\\\"\" ; claim.serve.stdout \"\\\"<value>\\\"\" ; claim.serve.exit \"0\"" @gen:e15df3fc754da1eb
