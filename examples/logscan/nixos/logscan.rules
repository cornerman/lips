q1 meta engine.demand.q1 stated "demand filter.input \"what kind of lines are filtered, and where do they come from?\"" @gen:1e7bd70bd88cb78d
q2 meta engine.demand.q2 stated "demand filter.match \"when should a line be kept?\"" @gen:1e7bd70bd88cb78d
q3 meta engine.demand.q3 stated "demand filter.output \"what should happen to a kept line?\"" @gen:1e7bd70bd88cb78d
q4 meta engine.demand.q4 stated "demand tool.command \"what should the installed command be called?\"" @gen:1e7bd70bd88cb78d
q5 meta engine.demand.q5 stated "demand witness.filter \"give an example: which lines, which arguments, and what must be printed?\"" @gen:1e7bd70bd88cb78d
r1 meta engine.rule.r1 stated "match fact filter.input => clause.logscan-main \"(define (logscan-main) (logscan-run (arguments)))\" ; clause.logscan-run \"(define (logscan-run spec) (let ((line (read-a-line))) (cond ((end-of-input? line) #t) (else (let ((shown (logscan-consider line spec))) (logscan-run spec))))))\"" @gen:1e7bd70bd88cb78d
r2 meta engine.rule.r2 stated "match fact filter.match => clause.logscan-keep? \"(define (logscan-keep? record spec) (cond ((null? spec) #t) ((logscan-matches? record (car spec)) (logscan-keep? record (cdr spec))) (else #f)))\" ; clause.logscan-matches? \"(define (logscan-matches? record arg) (let ((cut (string-cut arg #\\\\=))) (cond ((not cut) (die \\\"argument is not field=value:\\\" arg)) (else (equal? (field-of record (field-name cut)) (field-value cut))))))\"" @gen:1e7bd70bd88cb78d
r3 meta engine.rule.r3 stated "match fact filter.output => clause.logscan-consider \"(define (logscan-consider line spec) (let ((record (json-parse line))) (cond ((not record) #f) ((logscan-keep? record spec) (emit line)) (else #f))))\"" @gen:1e7bd70bd88cb78d
r4 meta engine.rule.r4 stated "match fact tool.command => site.<self>.command \"\\\"<value>\\\"\" ; environment.systemPackages \"[ ${site} ]\"" @gen:1e7bd70bd88cb78d
r5 meta engine.rule.r5 stated "match fact witness.filter => claim.filter.feed \"[ \\\"<value.1>\\\" \\\"<value.2>\\\" ]\" ; claim.filter.args \"[ \\\"<value.3>\\\" ]\" ; claim.filter.call \"(begin (logscan-main) (emitted))\" ; claim.filter.equals \"(list \\\"#<value.4>\\\")\"" @gen:1e7bd70bd88cb78d
