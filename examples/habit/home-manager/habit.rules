r2 meta engine.rule.r2 stated "match fact cli.habit => clause.habit-habit-name \"(define (habit-habit-name args) (cond ((null? args) (die \\\"no habit named\\\" \\\"arguments\\\")) (else (car args))))\"" @gen:de9bf00f29f8f957
r3 meta engine.rule.r3 stated "match fact input.source => clause.habit-read-log \"(define (habit-read-log) (habit-collect (read-a-line)))\" ; clause.habit-collect \"(define (habit-collect l) (cond ((end-of-input? l) (quote ())) ((eq? (habit-parse-line l) #f) (habit-read-log)) (else (cons (habit-parse-line l) (habit-read-log)))))\"" @gen:de9bf00f29f8f957
r4 meta engine.rule.r4 stated "match fact log.format => clause.habit-parse-line \"(define (habit-parse-line s) (habit-cut s (habit-find-tab s 0)))\" ; clause.habit-cut \"(define (habit-cut s i) (cond ((eq? i #f) #f) (else (cons (substring s 0 i) (substring s (+ i 1) (string-length s))))))\" ; clause.habit-find-tab \"(define (habit-find-tab s i) (cond ((>= i (string-length s)) #f) ((string=? (substring s i (+ i 1)) \\\"\\\\t\\\") i) (else (habit-find-tab s (+ i 1)))))\"" @gen:de9bf00f29f8f957
r5 meta engine.rule.r5 stated "match fact render.span => clause.habit-main \"(define (habit-main) (emit (habit-render (habit-read-log) (habit-habit-name (arguments)))))\" ; clause.habit-render \"(define (habit-render entries name) (cond ((null? entries) \\\"\\\") (else (habit-marks entries name (habit-earliest entries) (habit-latest entries)))))\" ; clause.habit-earliest \"(define (habit-earliest entries) (cond ((null? (cdr entries)) (car (car entries))) (else (habit-smaller (car (car entries)) (habit-earliest (cdr entries))))))\" ; clause.habit-latest \"(define (habit-latest entries) (cond ((null? (cdr entries)) (car (car entries))) (else (habit-larger (car (car entries)) (habit-latest (cdr entries))))))\" ; clause.habit-smaller \"(define (habit-smaller a b) (cond ((string<? a b) a) (else b)))\" ; clause.habit-larger \"(define (habit-larger a b) (cond ((string<? a b) b) (else a)))\" ; clause.habit-logged? \"(define (habit-logged? entries date name) (cond ((null? entries) #f) ((and (string=? (car (car entries)) date) (string=? (cdr (car entries)) name)) #t) (else (habit-logged? (cdr entries) date name))))\" ; clause.habit-marks \"(define (habit-marks entries name date last) (cond ((string<? last date) \\\"\\\") (else (string-append (habit-mark entries date name) (habit-marks entries name (habit-next-date date) last)))))\" ; clause.habit-mark \"(define (habit-mark entries date name) (cond ((habit-logged? entries date name) (habit-mark-logged)) (else (habit-mark-missing))))\" ; clause.habit-next-date \"(define (habit-next-date s) (habit-roll (string->number (substring s 0 4)) (string->number (substring s 5 7)) (string->number (substring s 8 10))))\" ; clause.habit-roll \"(define (habit-roll y m d) (cond ((< d (habit-days-in-month y m)) (habit-iso y m (+ d 1))) ((< m 12) (habit-iso y (+ m 1) 1)) (else (habit-iso (+ y 1) 1 1))))\" ; clause.habit-days-in-month \"(define (habit-days-in-month y m) (cond ((= m 2) (habit-feb y)) ((= m 4) 30) ((= m 6) 30) ((= m 9) 30) ((= m 11) 30) (else 31)))\" ; clause.habit-feb \"(define (habit-feb y) (cond ((habit-leap? y) 29) (else 28)))\" ; clause.habit-leap? \"(define (habit-leap? y) (and (= 0 (remainder y 4)) (or (not (= 0 (remainder y 100))) (= 0 (remainder y 400)))))\" ; clause.habit-iso \"(define (habit-iso y m d) (string-append (number->string y) \\\"-\\\" (habit-pad2 m) \\\"-\\\" (habit-pad2 d)))\" ; clause.habit-pad2 \"(define (habit-pad2 n) (cond ((< n 10) (string-append \\\"0\\\" (number->string n))) (else (number->string n))))\"" @gen:de9bf00f29f8f957
r6 meta engine.rule.r6 stated "match fact mark.logged => clause.habit-mark-logged \"(define (habit-mark-logged) \\\"#<value>\\\")\"" @gen:de9bf00f29f8f957
r7 meta engine.rule.r7 stated "match fact mark.missing => clause.habit-mark-missing \"(define (habit-mark-missing) \\\"#<value>\\\")\"" @gen:de9bf00f29f8f957
r8 meta engine.rule.r8 stated "match fact install.command => site.<self>.command \"\\\"<value>\\\"\" ; home.packages \"[ ${site} ]\"" @gen:de9bf00f29f8f957
r9 meta engine.rule.r9 stated "match fact witness.<q>.expected => claim.<q>.args \"[ \\\"<q>\\\" ]\" ; claim.<q>.call \"(begin (habit-main) (emitted))\" ; claim.<q>.equals \"(list \\\"#<value>\\\")\"" @gen:de9bf00f29f8f957
r10 meta engine.rule.r10 stated "match fact witness.<q>.entry.<n> => claim.<q>.feed \"[ \\\"<value.1>\\\\t<value.2>\\\" ]\"" @gen:de9bf00f29f8f957
