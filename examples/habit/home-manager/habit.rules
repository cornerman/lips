r1 meta engine.rule.r1 stated "match fact input.habit => clause.habit-name \"(define (habit-name) (car (arguments)))\"" @gen:b7d37100c274b993
r2 meta engine.rule.r2 stated "match fact input.source => clause.habit-read-log \"(define (habit-read-log) (let ((line (read-a-line))) (if (end-of-input? line) (quote ()) (let ((entry (habit-parse-entry line))) (cons entry (habit-read-log))))))\"" @gen:b7d37100c274b993
r3 meta engine.rule.r3 stated "match fact log.format => clause.habit-parse-entry \"(define (habit-parse-entry line) (let ((cut (string-cut line #\\\\tab))) (if (not cut) (die \\\"log line is not a date and a habit separated by a tab:\\\" line) (cons (habit-parse-date (car cut)) (cdr cut)))))\" ; clause.habit-parse-date \"(define (habit-parse-date text) (let ((a (string-cut text #\\\\-))) (if (not a) (die \\\"not an ISO date:\\\" text) (let ((b (string-cut (cdr a) #\\\\-))) (if (not b) (die \\\"not an ISO date:\\\" text) (list (string->number (car a)) (string->number (car b)) (string->number (cdr b))))))))\"" @gen:b7d37100c274b993
r4 meta engine.rule.r4 stated "match fact render.days => clause.habit-main \"(define (habit-main) (let* ((habit (habit-name)) (entries (habit-read-log))) (if (null? entries) (emit \\\"\\\") (emit (habit-render habit entries)))))\" ; clause.habit-render \"(define (habit-render habit entries) (let* ((dates (habit-dates-of entries)) (days (habit-logged-days habit entries))) (habit-marks (habit-earliest dates) (habit-latest dates) days)))\" ; clause.habit-marks \"(define (habit-marks day last days) (if (habit-date-before? last day) \\\"\\\" (string-append (if (habit-logged? day days) (habit-present-mark) (habit-absent-mark)) (habit-marks (habit-next-day day) last days))))\" ; clause.habit-dates-of \"(define (habit-dates-of entries) (if (null? entries) (quote ()) (cons (car (car entries)) (habit-dates-of (cdr entries)))))\" ; clause.habit-logged-days \"(define (habit-logged-days habit entries) (cond ((null? entries) (quote ())) ((string=? (cdr (car entries)) habit) (cons (car (car entries)) (habit-logged-days habit (cdr entries)))) (else (habit-logged-days habit (cdr entries)))))\" ; clause.habit-logged? \"(define (habit-logged? day days) (cond ((null? days) #f) ((habit-date-same? day (car days)) #t) (else (habit-logged? day (cdr days)))))\" ; clause.habit-earliest \"(define (habit-earliest dates) (if (null? (cdr dates)) (car dates) (let ((rest (habit-earliest (cdr dates)))) (if (habit-date-before? (car dates) rest) (car dates) rest))))\" ; clause.habit-latest \"(define (habit-latest dates) (if (null? (cdr dates)) (car dates) (let ((rest (habit-latest (cdr dates)))) (if (habit-date-before? rest (car dates)) (car dates) rest))))\" ; clause.habit-date-same? \"(define (habit-date-same? a b) (and (= (car a) (car b)) (= (car (cdr a)) (car (cdr b))) (= (car (cdr (cdr a))) (car (cdr (cdr b))))))\" ; clause.habit-date-before? \"(define (habit-date-before? a b) (cond ((not (= (car a) (car b))) (< (car a) (car b))) ((not (= (car (cdr a)) (car (cdr b)))) (< (car (cdr a)) (car (cdr b)))) (else (< (car (cdr (cdr a))) (car (cdr (cdr b)))))))\" ; clause.habit-next-day \"(define (habit-next-day day) (let ((y (car day)) (m (car (cdr day))) (d (car (cdr (cdr day))))) (cond ((< d (habit-days-in-month y m)) (list y m (+ d 1))) ((< m 12) (list y (+ m 1) 1)) (else (list (+ y 1) 1 1)))))\" ; clause.habit-days-in-month \"(define (habit-days-in-month y m) (cond ((= m 2) (if (habit-leap-year? y) 29 28)) ((= m 4) 30) ((= m 6) 30) ((= m 9) 30) ((= m 11) 30) (else 31)))\" ; clause.habit-leap-year? \"(define (habit-leap-year? y) (cond ((habit-multiple-of? y 400) #t) ((habit-multiple-of? y 100) #f) (else (habit-multiple-of? y 4))))\" ; clause.habit-multiple-of? \"(define (habit-multiple-of? n k) (cond ((= n 0) #t) ((< n k) #f) (else (habit-multiple-of? (- n k) k))))\"" @gen:b7d37100c274b993
r5 meta engine.rule.r5 stated "match fact mark.present => clause.habit-present-mark \"(define (habit-present-mark) \\\"#<value>\\\")\"" @gen:b7d37100c274b993
r6 meta engine.rule.r6 stated "match fact mark.absent => clause.habit-absent-mark \"(define (habit-absent-mark) \\\"#<value>\\\")\"" @gen:b7d37100c274b993
