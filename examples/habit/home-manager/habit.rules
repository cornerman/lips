r8 meta engine.rule.r8 stated "match fact witness.<q>.prints => claim.<q>.args \"[ \\\"<value.7>\\\" ]\" ; claim.<q>.feed \"[ \\\"<value.1>\\\\t<value.2>\\\" \\\"<value.3>\\\\t<value.4>\\\" \\\"<value.5>\\\\t<value.6>\\\" ]\" ; claim.<q>.call \"(begin (habit-main) (emitted))\" ; claim.<q>.equals \"(list \\\"#<value.8>\\\")\"" @gen:b7d37100c274b993
