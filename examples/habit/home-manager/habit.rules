r1 meta engine.rule.r1 stated "match fact input.habit => clause.habit-name \"(define (habit-name) (car (arguments)))\"" @gen:b7d37100c274b993
r2 meta engine.rule.r2 stated "match fact input.source => clause.read-log \"(define (read-log) (let ((line (read-a-line))) (if (end-of-input? line) (quote ()) (let ((entry (parse-entry line))) (cons entry (read-log))))))\"" @gen:b7d37100c274b993
r3 meta engine.rule.r3 stated "match fact log.format => clause.parse-entry \"(define (parse-entry line) (let ((cut (string-cut line #\\\\tab))) (if (not cut) (die \\\"log line is not a date and a habit separated by a tab:\\\" line) (cons (parse-date (car cut)) (cdr cut)))))\" ; clause.parse-date \"(define (parse-date text) (let ((a (string-cut text #\\\\-))) (if (not a) (die \\\"not an ISO date:\\\" text) (let ((b (string-cut (cdr a) #\\\\-))) (if (not b) (die \\\"not an ISO date:\\\" text) (list (string->number (car a)) (string->number (car b)) (string->number (cdr b))))))))\"" @gen:b7d37100c274b993
r4 meta engine.rule.r4 stated "match fact render.days => clause.main \"(define (main) (let* ((habit (habit-name)) (entries (read-log))) (if (null? entries) (emit \\\"\\\") (emit (render habit entries)))))\" ; clause.render \"(define (render habit entries) (let* ((dates (dates-of entries)) (days (logged-days habit entries))) (marks (earliest dates) (latest dates) days)))\" ; clause.marks \"(define (marks day last days) (if (date-before? last day) \\\"\\\" (string-append (if (logged? day days) (present-mark) (absent-mark)) (marks (next-day day) last days))))\" ; clause.dates-of \"(define (dates-of entries) (if (null? entries) (quote ()) (cons (car (car entries)) (dates-of (cdr entries)))))\" ; clause.logged-days \"(define (logged-days habit entries) (cond ((null? entries) (quote ())) ((string=? (cdr (car entries)) habit) (cons (car (car entries)) (logged-days habit (cdr entries)))) (else (logged-days habit (cdr entries)))))\" ; clause.logged? \"(define (logged? day days) (cond ((null? days) #f) ((date-same? day (car days)) #t) (else (logged? day (cdr days)))))\" ; clause.earliest \"(define (earliest dates) (if (null? (cdr dates)) (car dates) (let ((rest (earliest (cdr dates)))) (if (date-before? (car dates) rest) (car dates) rest))))\" ; clause.latest \"(define (latest dates) (if (null? (cdr dates)) (car dates) (let ((rest (latest (cdr dates)))) (if (date-before? rest (car dates)) (car dates) rest))))\" ; clause.date-same? \"(define (date-same? a b) (and (= (car a) (car b)) (= (car (cdr a)) (car (cdr b))) (= (car (cdr (cdr a))) (car (cdr (cdr b))))))\" ; clause.date-before? \"(define (date-before? a b) (cond ((not (= (car a) (car b))) (< (car a) (car b))) ((not (= (car (cdr a)) (car (cdr b)))) (< (car (cdr a)) (car (cdr b)))) (else (< (car (cdr (cdr a))) (car (cdr (cdr b)))))))\" ; clause.next-day \"(define (next-day day) (let ((y (car day)) (m (car (cdr day))) (d (car (cdr (cdr day))))) (cond ((< d (days-in-month y m)) (list y m (+ d 1))) ((< m 12) (list y (+ m 1) 1)) (else (list (+ y 1) 1 1)))))\" ; clause.days-in-month \"(define (days-in-month y m) (cond ((= m 2) (if (leap-year? y) 29 28)) ((= m 4) 30) ((= m 6) 30) ((= m 9) 30) ((= m 11) 30) (else 31)))\" ; clause.leap-year? \"(define (leap-year? y) (cond ((multiple-of? y 400) #t) ((multiple-of? y 100) #f) (else (multiple-of? y 4))))\" ; clause.multiple-of? \"(define (multiple-of? n k) (cond ((= n 0) #t) ((< n k) #f) (else (multiple-of? (- n k) k))))\"" @gen:b7d37100c274b993
r5 meta engine.rule.r5 stated "match fact mark.present => clause.present-mark \"(define (present-mark) \\\"#<value>\\\")\"" @gen:b7d37100c274b993
r6 meta engine.rule.r6 stated "match fact mark.absent => clause.absent-mark \"(define (absent-mark) \\\"#<value>\\\")\"" @gen:b7d37100c274b993
r7 meta engine.rule.r7 stated "match fact tool.command => site.<self>.command \"\\\"<value>\\\"\" ; home.packages \"[ ${site} ]\"" @gen:b7d37100c274b993
r8 meta engine.rule.r8 stated "match fact witness.<q>.prints => claim.<q>.args \"[ \\\"<value.7>\\\" ]\" ; claim.<q>.feed \"[ \\\"<value.1>\\\\t<value.2>\\\" \\\"<value.3>\\\\t<value.4>\\\" \\\"<value.5>\\\\t<value.6>\\\" ]\" ; claim.<q>.call \"(begin (main) (emitted))\" ; claim.<q>.equals \"(list \\\"#<value.8>\\\")\"" @gen:b7d37100c274b993
