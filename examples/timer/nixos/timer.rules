q1 meta engine.demand.q1 stated "demand job.command \"which command should the job run (an absolute path)?\"" @gen:feca675b47be641f
q2 meta engine.demand.q2 stated "demand job.schedule \"at what time of day should the job run, as HH:MM?\"" @gen:feca675b47be641f
q3 meta engine.demand.q3 stated "demand job.name \"what should the job be called?\"" @gen:feca675b47be641f
r1 meta engine.rule.r1 stated "match fact job.command => systemd.services.<self>.serviceConfig.ExecStart \"\\\"<value>\\\"\" ; systemd.services.<self>.serviceConfig.Type \"\\\"oneshot\\\"\"" @gen:feca675b47be641f
r2 meta engine.rule.r2 stated "match fact job.schedule => systemd.timers.<self>.timerConfig.OnCalendar \"\\\"*-*-* <value>:00\\\"\" ; systemd.timers.<self>.wantedBy \"[ \\\"timers.target\\\" ]\"" @gen:feca675b47be641f
r3 meta engine.rule.r3 stated "match fact job.name => systemd.services.<self>.description \"\\\"<value>\\\"\" ; systemd.timers.<self>.description \"\\\"<value>\\\"\"" @gen:feca675b47be641f
