r2 meta engine.rule.r2 stated "match fact input.source => clause.read-lines \"(define (read-lines) (let ((l (read-a-line))) (if (end-of-input? l) (list) (cons l (read-lines)))))\"" @gen:7f5452f6fc714d53
r3 meta engine.rule.r3 stated "match fact board.syntax => clause.first-word \"(define (first-word text) (let ((c (string-cut text #\\\\space))) (if c (car c) text)))\" ; clause.rest-after \"(define (rest-after text) (let ((c (string-cut text #\\\\space))) (if c (cdr c) \\\"\\\")))\" ; clause.column-marker \"(define (column-marker) (first-word \\\"#<value.1>\\\"))\" ; clause.card-marker \"(define (card-marker) (first-word \\\"#<value.2>\\\"))\" ; clause.is-column \"(define (is-column line) (equal? (first-word line) (column-marker)))\" ; clause.is-card \"(define (is-card line) (equal? (first-word line) (card-marker)))\" ; clause.column-name \"(define (column-name line) (rest-after line))\" ; clause.card-text \"(define (card-text line) (rest-after line))\" ; clause.cards-of \"(define (cards-of name lines) (cond ((null? lines) (list)) ((and (is-column (car lines)) (equal? (column-name (car lines)) name)) (cards-until (cdr lines))) (else (cards-of name (cdr lines)))))\" ; clause.cards-until \"(define (cards-until lines) (cond ((null? lines) (list)) ((is-column (car lines)) (list)) ((is-card (car lines)) (cons (card-text (car lines)) (cards-until (cdr lines)))) (else (cards-until (cdr lines)))))\"" @gen:7f5452f6fc714d53
r4 meta engine.rule.r4 stated "match fact board.columns => clause.trim \"(define (trim text) (let ((c (string-cut text #\\\\space))) (if (and c (equal? (car c) \\\"\\\")) (trim (cdr c)) text)))\" ; clause.split-columns \"(define (split-columns text) (let ((c (string-cut text #\\\\,))) (if c (cons (trim (car c)) (split-columns (trim (cdr c)))) (list (trim text)))))\" ; clause.columns \"(define (columns) (split-columns \\\"#<value>\\\"))\"" @gen:7f5452f6fc714d53
r5 meta engine.rule.r5 stated "match fact output.separator => clause.join \"(define (join items sep) (cond ((null? items) \\\"\\\") ((null? (cdr items)) (car items)) (else (string-append (car items) (string-append sep (join (cdr items) sep))))))\" ; clause.render-column \"(define (render-column name cards) (if (null? cards) (render-empty name) (string-append name (string-append \\\": \\\" (join cards \\\"#<value>\\\")))))\" ; clause.print-columns \"(define (print-columns names lines) (if (null? names) #t (let ((x (emit (render-column (car names) (cards-of (car names) lines))))) (print-columns (cdr names) lines))))\" ; clause.main \"(define (main) (print-columns (columns) (read-lines)))\"" @gen:7f5452f6fc714d53
r6 meta engine.rule.r6 stated "match fact output.empty => clause.render-empty \"(define (render-empty name) (string-append name \\\":\\\"))\"" @gen:7f5452f6fc714d53
r7 meta engine.rule.r7 stated "match fact tool.command => site.<self>.command \"\\\"<value>\\\"\" ; home.packages \"[ ${site} ]\"" @gen:7f5452f6fc714d53
r8 meta engine.rule.r8 stated "match fact witness.feed => claim.board.feed \"[ \\\"<value.1>\\\" \\\"<value.2>\\\" \\\"<value.3>\\\" \\\"<value.4>\\\" \\\"<value.5>\\\" ]\" ; claim.board.call \"(begin (main) (emitted))\"" @gen:7f5452f6fc714d53
r9 meta engine.rule.r9 stated "match fact witness.out => claim.board.equals \"(list \\\"#<value.1>\\\" \\\"#<value.2>\\\" \\\"#<value.3>\\\")\"" @gen:7f5452f6fc714d53
