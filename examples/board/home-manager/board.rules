r2 meta engine.rule.r2 stated "match fact input.source => clause.board-read-lines \"(define (board-read-lines) (let ((l (read-a-line))) (if (end-of-input? l) (list) (cons l (board-read-lines)))))\"" @gen:7f5452f6fc714d53
r3 meta engine.rule.r3 stated "match fact board.syntax => clause.board-first-word \"(define (board-first-word text) (let ((c (string-cut text #\\\\space))) (if c (car c) text)))\" ; clause.board-rest-after \"(define (board-rest-after text) (let ((c (string-cut text #\\\\space))) (if c (cdr c) \\\"\\\")))\" ; clause.board-column-marker \"(define (board-column-marker) (board-first-word \\\"#<value.1>\\\"))\" ; clause.board-card-marker \"(define (board-card-marker) (board-first-word \\\"#<value.2>\\\"))\" ; clause.board-is-column \"(define (board-is-column line) (equal? (board-first-word line) (board-column-marker)))\" ; clause.board-is-card \"(define (board-is-card line) (equal? (board-first-word line) (board-card-marker)))\" ; clause.board-column-name \"(define (board-column-name line) (board-rest-after line))\" ; clause.board-card-text \"(define (board-card-text line) (board-rest-after line))\" ; clause.board-cards-of \"(define (board-cards-of name lines) (cond ((null? lines) (list)) ((and (board-is-column (car lines)) (equal? (board-column-name (car lines)) name)) (board-cards-until (cdr lines))) (else (board-cards-of name (cdr lines)))))\" ; clause.board-cards-until \"(define (board-cards-until lines) (cond ((null? lines) (list)) ((board-is-column (car lines)) (list)) ((board-is-card (car lines)) (cons (board-card-text (car lines)) (board-cards-until (cdr lines)))) (else (board-cards-until (cdr lines)))))\"" @gen:7f5452f6fc714d53
r4 meta engine.rule.r4 stated "match fact board.columns => clause.board-trim \"(define (board-trim text) (let ((c (string-cut text #\\\\space))) (if (and c (equal? (car c) \\\"\\\")) (board-trim (cdr c)) text)))\" ; clause.board-split-columns \"(define (board-split-columns text) (let ((c (string-cut text #\\\\,))) (if c (cons (board-trim (car c)) (board-split-columns (board-trim (cdr c)))) (list (board-trim text)))))\" ; clause.board-columns \"(define (board-columns) (board-split-columns \\\"#<value>\\\"))\"" @gen:7f5452f6fc714d53
r5 meta engine.rule.r5 stated "match fact output.separator => clause.board-join \"(define (board-join items sep) (cond ((null? items) \\\"\\\") ((null? (cdr items)) (car items)) (else (string-append (car items) (string-append sep (board-join (cdr items) sep))))))\" ; clause.board-render-column \"(define (board-render-column name cards) (if (null? cards) (board-render-empty name) (string-append name (string-append \\\": \\\" (board-join cards \\\"#<value>\\\")))))\" ; clause.board-print-columns \"(define (board-print-columns names lines) (if (null? names) #t (let ((x (emit (board-render-column (car names) (board-cards-of (car names) lines))))) (board-print-columns (cdr names) lines))))\" ; clause.board-main \"(define (board-main) (board-print-columns (board-columns) (board-read-lines)))\"" @gen:7f5452f6fc714d53
r6 meta engine.rule.r6 stated "match fact output.empty => clause.board-render-empty \"(define (board-render-empty name) (string-append name \\\":\\\"))\"" @gen:7f5452f6fc714d53
r7 meta engine.rule.r7 stated "match fact tool.command => site.<self>.command \"\\\"<value>\\\"\" ; home.packages \"[ ${site} ]\"" @gen:7f5452f6fc714d53
r8 meta engine.rule.r8 stated "match fact witness.feed => claim.board.feed \"[ \\\"<value.1>\\\" \\\"<value.2>\\\" \\\"<value.3>\\\" \\\"<value.4>\\\" \\\"<value.5>\\\" ]\" ; claim.board.call \"(begin (board-main) (emitted))\"" @gen:7f5452f6fc714d53
r9 meta engine.rule.r9 stated "match fact witness.out => claim.board.equals \"(list \\\"#<value.1>\\\" \\\"#<value.2>\\\" \\\"#<value.3>\\\")\"" @gen:7f5452f6fc714d53
