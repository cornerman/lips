q1 meta engine.demand.q1 stated "demand workdir.access \"how may the agent use the directory it is started in -- read and write it, or only read it?\"" @gen:d95ce33ac8994c8b
r1 meta engine.rule.r1 stated "match fact workdir.access => workdir.access \"\\\"<value>\\\"\" ; meta.name \"\\\"<self>\\\"\"" @gen:d95ce33ac8994c8b
r2 meta engine.rule.r2 stated "match fact fs.read.<n> => filesystem.read \"[ \\\"<value>\\\" ]\"" @gen:d95ce33ac8994c8b
r3 meta engine.rule.r3 stated "match fact fs.deny.<n> => filesystem.deny \"[ \\\"<value>\\\" ]\"" @gen:d95ce33ac8994c8b
r4 meta engine.rule.r4 stated "match fact cmd.<c>.policy => command_policies.commands.<c>.from.session.invocation_policy.default \"\\\"<value>\\\"\" ; command_policies.commands.<c>.from.session.sandbox.fs_read \"[  ]\"" @gen:d95ce33ac8994c8b
r5 meta engine.rule.r5 stated "match fact cmd.<cmd>.approve => command_policies.commands.<cmd>.from.session.invocation_policy.approve \"[ { argv = { prefix = [ \\\"<value>\\\" ]; }; } ]\" ; command_policies.approval_backends.terminal.type \"\\\"terminal\\\"\" ; command_policies.approval_defaults.backend \"\\\"terminal\\\"\"" @gen:d95ce33ac8994c8b
r6 meta engine.rule.r6 stated "match fact net.allow.<n> => network.allow_domain \"[ \\\"<value>\\\" ]\"" @gen:d95ce33ac8994c8b
