p1 meta lang.pattern.p1 stated "back up <src> to <dst> every night => fact backup.job stated \"<src> <dst>\"" @lang:0
p2 meta lang.pattern.p2 stated "keep <count> daily snapshots => fact backup.retention stated \"<count>\"" @lang:0
q1 meta engine.demand.q1 stated "demand backup.job \"what should be backed up and where should it go?\"" @lang:0
q2 meta engine.demand.q2 stated "demand backup.retention \"how many daily snapshots should be kept?\"" @lang:0
r1 meta engine.rule.r1 stated "match fact backup.job => systemd.services.ledger-backup.serviceConfig.Type \"\\\"oneshot\\\"\" ; systemd.services.ledger-backup.environment.RESTIC_REPOSITORY \"\\\"<value.2>\\\"\" ; systemd.services.ledger-backup.serviceConfig.EnvironmentFile \"\\\"/etc/ledger-backup.env\\\"\" ; systemd.services.ledger-backup.serviceConfig.ExecStart \"\\\"${pkgs.restic}/bin/restic backup <value.1>\\\"\" ; systemd.timers.ledger-backup.wantedBy \"[ \\\"timers.target\\\" ]\" ; systemd.timers.ledger-backup.timerConfig.OnCalendar \"\\\"daily\\\"\" ; systemd.timers.ledger-backup.timerConfig.Persistent \"true\"" @lang:0
r2 meta engine.rule.r2 stated "match fact backup.retention => systemd.services.ledger-backup.serviceConfig.ExecStartPost \"\\\"${pkgs.restic}/bin/restic forget --keep-daily <value> --prune\\\"\"" @lang:0
