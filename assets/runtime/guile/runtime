# Guile: GNU's Scheme, a native runtime with a fast start. The name of this
# runtime is the name of this directory; the files below are linked before the
# minted core, in this order.
property native
property fast-start

# Every contract guile's adapters provide. A program reaching for anything not
# listed here fails loud at compile, naming the contract.
provides json-parse string-cut field-of field-name field-value random-step elements-of
provides arguments read-a-line end-of-input? emit die
# Provided while a claim is judging, by the in-memory adapter below.
provides emitted

package guile
package guile-json

# The pure adapters, linked for every purpose.
file adapter-pure.scm

# The adapters that touch the world, linked for a real run only.
effect-file adapter-effects.scm

# The last line of main.scm: how this runtime starts a program. Data, because
# lips must not know how any runtime spells it. A clause reads the command line
# through the `arguments` contract, so the entry passes nothing -- and lips
# DERIVES from this line that the core must define `main` taking no parameters,
# refusing a core that does not.
entry (<language>-main)

# The Nix file that turns the linked site into a runnable derivation. It takes
# { pkgs, name, src } and returns one; lips copies it and calls it.
build site.nix

# Linked INSTEAD of the effect files when a claim judges the core offline: the
# same names backed by lists instead of stdin and stdout, then the harness that
# judges a claim and turns a failure into an exit code. Order matters: the
# harness is loaded after the adapters it may use.
claim-file adapter-effects-memory.scm
claim-file claim-harness.scm

# The words this runtime's harness answers to. lips owns the SHAPES -- a file is
# loaded by name, a claim is judged by id, expression and expected value -- and
# never the words, exactly as with `entry` above.
harness-load load
harness-feed-args feed-args
harness-feed-lines feed-lines
harness-judge claim
harness-done claims-done
harness-list list
