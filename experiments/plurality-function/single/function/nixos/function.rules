q1 meta engine.demand.q1 stated "demand func.<fname>.signature \"which function does this program declare, and what is its parameter called?\"" @gen:db71679ca87d8bca
r1 meta engine.rule.r1 stated "match fact func.<fname>.signature => clause.function-print \"(define (function-print name arg) (cond ((not (string=? name \\\"#<value.1>\\\")) (die \\\"undeclared function:\\\" name)) ((not (string? arg)) (die \\\"#<value.1>: parameter #<value.2> must be a String:\\\" arg)) (else (emit arg))))\" ; claim.main.call \"(begin (function-main) (emitted))\" ; site.<self>.command \"\\\"<self>\\\"\" ; environment.systemPackages \"[ ${site} ]\"" @gen:db71679ca87d8bca
r2 meta engine.rule.r2 stated "match fact call.<n> => clause.function-main \"[ (define (function-main) (function-print \\\"#<value.1>\\\" \\\"#<value.2>\\\")) ]\" ; claim.main.equals-lines \"[ \\\"<value.2>\\\" ]\"" @gen:db71679ca87d8bca
