r2 meta engine.rule.r2 stated "match fact call.<n> => clause.function-main \"[ (define (function-main) (function-println_to_stdout \\\"#<value>\\\")) ]\" ; claim.main.call \"(begin (function-main) (emitted))\" ; claim.main.equals-lines \"[ \\\"<value>\\\" ]\"" @gen:84eb115a36ed22ee
