r1 meta engine.rule.r1 stated "match fact report.count => clause.how-many \"(define (how-many) (count-of \\\"#<value>\\\"))\" ; clause.count-of \"(define (count-of word) (cond ((equal? word \\\"one\\\") 1) ((equal? word \\\"two\\\") 2) ((equal? word \\\"three\\\") 3) ((equal? word \\\"four\\\") 4) ((equal? word \\\"five\\\") 5) ((equal? word \\\"six\\\") 6) ((equal? word \\\"seven\\\") 7) ((equal? word \\\"eight\\\") 8) ((equal? word \\\"nine\\\") 9) ((equal? word \\\"ten\\\") 10) (else (die \\\"not a number of lines i know how to count\\\" word))))\" ; clause.main \"(define (main) (emit-lines (top-lines (tally (all-lines)) (how-many))))\" ; clause.all-lines \"(define (all-lines) (let ((line (read-a-line))) (if (end-of-input? line) (quote ()) (cons line (all-lines)))))\" ; clause.tally \"(define (tally lines) (tally-into lines (quote ())))\" ; clause.tally-into \"(define (tally-into lines counts) (if (null? lines) counts (tally-into (cdr lines) (bump (car lines) counts))))\" ; clause.bump \"(define (bump line counts) (cond ((null? counts) (list (cons line 1))) ((equal? (car (car counts)) line) (cons (cons line (+ (cdr (car counts)) 1)) (cdr counts))) (else (cons (car counts) (bump line (cdr counts))))))\" ; clause.top-lines \"(define (top-lines counts n) (if (or (null? counts) (not (> n 0))) (quote ()) (let ((best (most-common counts))) (cons (car best) (top-lines (without best counts) (- n 1))))))\" ; clause.most-common \"(define (most-common counts) (if (null? (cdr counts)) (car counts) (let ((rest (most-common (cdr counts)))) (if (> (cdr rest) (cdr (car counts))) rest (car counts)))))\" ; clause.without \"(define (without entry counts) (cond ((null? counts) (quote ())) ((equal? (car counts) entry) (cdr counts)) (else (cons (car counts) (without entry (cdr counts))))))\" ; clause.emit-lines \"(define (emit-lines lines) (if (null? lines) #t (let ((done (emit (car lines)))) (emit-lines (cdr lines)))))\"" @gen:b90a87aefa8cb758
