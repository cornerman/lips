r1 meta engine.rule.r1 stated "match fact report.recipient => systemd.services.<self>.environment.REPORT_RECIPIENT \"\\\"<value>\\\"\" ; systemd.services.<self>.serviceConfig.Type \"\\\"oneshot\\\"\" ; systemd.timers.<self>.wantedBy \"[ \\\"timers.target\\\" ]\" ; systemd.timers.<self>.timerConfig.OnCalendar \"\\\"daily\\\"\" ; systemd.timers.<self>.timerConfig.Persistent \"true\" ; clause.bump \"(define (bump counts line) (cond ((null? counts) (list (cons line 1))) ((string=? (car (car counts)) line) (cons (cons line (+ (cdr (car counts)) 1)) (cdr counts))) (else (cons (car counts) (bump (cdr counts) line)))))\" ; clause.collect \"(define (collect counts) (let ((line (read-a-line))) (if (end-of-input? line) counts (collect (bump counts line)))))\" ; clause.best \"(define (best counts champion) (cond ((null? counts) champion) ((> (cdr (car counts)) (cdr champion)) (best (cdr counts) (car counts))) (else (best (cdr counts) champion))))\" ; clause.without \"(define (without counts entry) (cond ((null? counts) (quote ())) ((string=? (car (car counts)) (car entry)) (cdr counts)) (else (cons (car counts) (without (cdr counts) entry)))))\" ; clause.top-n \"(define (top-n counts n) (cond ((null? counts) (quote ())) ((< n 1) (quote ())) (else (let ((top (best (cdr counts) (car counts)))) (cons top (top-n (without counts top) (- n 1)))))))\" ; clause.emit-all \"(define (emit-all entries) (cond ((null? entries) #t) (else (let ((done (emit (car (car entries))))) (emit-all (cdr entries))))))\" ; clause.main \"(define (main) (emit-all (top-n (collect (quote ())) 10)))\"" @gen:899fe30faf677bf6
r2 meta engine.rule.r2 stated "match fact tool.command => site.<self>.command \"\\\"<value>\\\"\" ; environment.systemPackages \"[ ${site} ]\" ; systemd.services.<self>.path \"[ ${site} ${pkgs.mailutils} ]\" ; systemd.services.<self>.script \"\\\"<value> | mail -s nightly-report $REPORT_RECIPIENT\\\"\"" @gen:899fe30faf677bf6
