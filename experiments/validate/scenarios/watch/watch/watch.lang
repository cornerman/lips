r1 meta engine.rule.r1 stated "match fact filter.word => clause.contains? \"(define (contains? line word) (let ((n (string-length line)) (m (string-length word))) (letrec ((scan (lambda (i) (cond ((> (+ i m) n) #f) ((string=? (substring line i (+ i m)) word) #t) (else (scan (+ i 1))))))) (scan 0))))\" ; clause.main \"(define (main) (let ((line (read-a-line))) (cond ((end-of-input? line) #t) ((contains? line \\\"#<value>\\\") (let ((printed (emit line))) (main))) (else (main)))))\"" @gen:8fa1c227d87a3600
r2 meta engine.rule.r2 stated "match fact install.command => site.<self>.command \"\\\"<value>\\\"\" ; environment.systemPackages \"[ ${site} ]\"" @gen:8fa1c227d87a3600
r3 meta engine.rule.r3 stated "match fact schedule.<cmd>.command => systemd.services.<cmd>.serviceConfig.ExecStart \"\\\"${site}/bin/<value>\\\"\" ; systemd.services.<cmd>.serviceConfig.Type \"\\\"oneshot\\\"\"" @gen:8fa1c227d87a3600
r4 meta engine.rule.r4 stated "match fact schedule.<cmd>.interval => systemd.timers.<cmd>.wantedBy \"[ \\\"timers.target\\\" ]\" ; systemd.timers.<cmd>.timerConfig.OnBootSec \"\\\"1min\\\"\" ; systemd.timers.<cmd>.timerConfig.OnUnitActiveSec \"\\\"<value>min\\\"\" ; systemd.timers.<cmd>.description \"\\\"runs <cmd> every <value> minutes\\\"\"" @gen:8fa1c227d87a3600
r5 meta engine.rule.r5 stated "match fact service.<name>.title => systemd.services.<name>.description \"\\\"<value>\\\"\" ; systemd.services.<name>.serviceConfig.SyslogIdentifier \"\\\"<value>\\\"\"" @gen:8fa1c227d87a3600
r6 meta engine.rule.r6 stated "match fact witness.input => claim.w1.feed \"[ \\\"<value.1>\\\" \\\"<value.2>\\\" ]\" ; claim.w1.call \"(begin (main) (emitted))\"" @gen:8fa1c227d87a3600
r7 meta engine.rule.r7 stated "match fact witness.output => claim.w1.equals \"(list \\\"#<value>\\\")\"" @gen:8fa1c227d87a3600
