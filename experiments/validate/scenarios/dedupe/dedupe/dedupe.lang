r1 meta engine.rule.r1 stated "match fact dedupe.behaviour => clause.main \"(define (main) (let ((dropped (dedupe-loop (quote ()) 0))) (emit (summary-line dropped))))\" ; clause.dedupe-loop \"(define (dedupe-loop seen dropped) (let ((line (read-a-line))) (cond ((end-of-input? line) dropped) ((seen? line seen) (dedupe-loop seen (+ dropped 1))) (else (let ((ignored (emit line))) (dedupe-loop (cons line seen) dropped))))))\" ; clause.seen? \"(define (seen? line seen) (cond ((null? seen) #f) ((equal? (car seen) line) #t) (else (seen? line (cdr seen)))))\"" @gen:2c699a061a56d31d
r2 meta engine.rule.r2 stated "match fact dropped.format => clause.summary-line \"(define (summary-line n) (let ((cut (string-cut \\\"#<value>\\\" #\\\\N))) (if cut (string-append (car cut) (number->string n) (cdr cut)) \\\"#<value>\\\")))\"" @gen:2c699a061a56d31d
