r1 meta engine.rule.r1 stated "match fact chunk.input => clause.main \"(define (main) (chunk-loop (quote ()) 0))\" ; clause.chunk-loop \"(define (chunk-loop pending count) (let ((line (read-a-line))) (cond ((end-of-input? line) (finish pending)) ((= (+ count 1) (group-size)) (let ((printed (emit-group (add-last pending line)))) (chunk-loop (quote ()) 0))) (else (chunk-loop (add-last pending line) (+ count 1))))))\" ; clause.add-last \"(define (add-last items item) (cond ((null? items) (cons item (quote ()))) (else (cons (car items) (add-last (cdr items) item)))))\"" @gen:52bd5810805f2a86
r2 meta engine.rule.r2 stated "match fact chunk.group.size => clause.group-size \"(define (group-size) (count-named \\\"#<value>\\\"))\" ; clause.count-named \"(define (count-named word) (cond ((equal? word \\\"one\\\") 1) ((equal? word \\\"two\\\") 2) ((equal? word \\\"three\\\") 3) ((equal? word \\\"four\\\") 4) ((equal? word \\\"five\\\") 5) ((equal? word \\\"six\\\") 6) ((equal? word \\\"seven\\\") 7) ((equal? word \\\"eight\\\") 8) ((equal? word \\\"nine\\\") 9) ((equal? word \\\"ten\\\") 10) (else (die \\\"not a group size I know:\\\" word))))\"" @gen:52bd5810805f2a86
